<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Kept out of Syncly.slnx on purpose: it needs the MAUI workload, which the desktop and
       test builds must not depend on. Build it with `dotnet build src/Syncly.Mobile`. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>Syncly.Mobile</RootNamespace>
    <ApplicationTitle>Syncly</ApplicationTitle>
    <ApplicationId>dev.syncly.app</ApplicationId>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(AndroidVersionCode)' != ''">$(AndroidVersionCode)</ApplicationVersion>
    <ApplicationVersion Condition="'$(AndroidVersionCode)' == ''">1</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#08080a" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#08080a" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Syncly.App\Syncly.App.csproj" />
    <ProjectReference Include="..\Syncly.Model\Syncly.Model.csproj" />
    <ProjectReference Include="..\Syncly.Sync\Syncly.Sync.csproj" />
    <ProjectReference Include="..\Syncly.UI\Syncly.UI.csproj" />
  </ItemGroup>

  <!-- CSS/JS live in Syncly.UI. index.html is local so Android can set autostart="false". -->
  <ItemGroup>
    <MauiAsset Include="..\Syncly.UI\wwwroot\**\*"
               Exclude="..\Syncly.UI\wwwroot\index.html"
               LogicalName="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
