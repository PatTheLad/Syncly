<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Syncly</AssemblyName>
    <RootNamespace>Syncly.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Syncly.App\Syncly.App.csproj" />
    <ProjectReference Include="..\Syncly.UI\Syncly.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Photino serves files from disk, so the shared UI assets are copied next to the host. -->
  <Target Name="CopyUiAssets" AfterTargets="Build">
    <ItemGroup>
      <_UiAssets Include="..\Syncly.UI\wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_UiAssets)" DestinationFiles="@(_UiAssets->'$(OutputPath)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyUiAssetsToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_UiPublishAssets Include="..\Syncly.UI\wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_UiPublishAssets)" DestinationFiles="@(_UiPublishAssets->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
