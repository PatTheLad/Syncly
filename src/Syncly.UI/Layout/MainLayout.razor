@namespace Syncly.UI.Layout
@inherits LayoutComponentBase
@inject Syncly.UI.Services.AppState State
@implements IDisposable

<div class="shell">
    <header class="topbar">
        <a class="brand" href="">Syncly</a>
        <nav>
            <NavLink href="" Match="NavLinkMatch.All">Devices</NavLink>
            <NavLink href="notes">Notes</NavLink>
            <NavLink href="sync">Sync</NavLink>
            <NavLink href="pairing">Pairing</NavLink>
            <NavLink href="settings">Settings</NavLink>
        </nav>
    </header>
    @if (State.Pairing.PendingRemote is { } pending)
    {
        <div class="panel" style="margin:0;padding:0.85rem 1.5rem;border-bottom:1px solid var(--line);background:rgba(61,186,124,0.08)">
            <div class="row">
                <div>
                    Trust <strong>@pending.DisplayName</strong>?
                    <span class="fingerprint">@pending.PublicKeyFingerprint</span>
                </div>
                <div class="row" style="gap:0.5rem">
                    <button @onclick="() => State.Pairing.Respond(true)">Trust</button>
                    <button class="danger" @onclick="() => State.Pairing.Respond(false)">Reject</button>
                </div>
            </div>
        </div>
    }
    <main class="content">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;
}
