@namespace Syncly.UI.Layout
@inherits LayoutComponentBase
@inject Syncly.UI.Services.AppState State
@implements IDisposable

<div class="shell">
    @if (State.Pairing.PendingRemote is { } pending)
    {
        <div class="trust-banner">
            <div>
                Trust <strong>@pending.DisplayName</strong>?
                <span class="fingerprint">@pending.PublicKeyFingerprint</span>
            </div>
            <div class="row" style="gap:0.4rem">
                <button @onclick="() => State.Pairing.Respond(true)">Trust</button>
                <button class="danger" @onclick="() => State.Pairing.Respond(false)">Reject</button>
            </div>
        </div>
    }

    <nav class="rail" aria-label="Primary">
        <NavLink class="rail-brand" href="" Match="NavLinkMatch.All" title="Syncly">S</NavLink>
        <NavLink href="" Match="NavLinkMatch.All" title="Notes">✎</NavLink>
        <NavLink href="devices" title="Devices">◉</NavLink>
        <NavLink href="sync" title="Sync">↻</NavLink>
        <NavLink href="pairing" title="Pairing">☍</NavLink>
        <div class="rail-spacer"></div>
        <NavLink href="settings" title="Settings">⚙</NavLink>
    </nav>

    <div class="workspace">
        @Body
    </div>
</div>

@code {
    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;
}
