@namespace Syncly.UI.Layout
@inherits LayoutComponentBase
@implements IDisposable
@inject EditorState State
@inject SynclyApp App
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IAppUpdater Updater

<div class="shell @(State.SidebarOpen ? null : "no-sidebar")">
    <nav class="rail">
        <button type="button"
                class="rail-brand space-avatar"
                style="background: @(State.CurrentSpace?.Accent ?? SpaceColors.Default)"
                title="@(State.CurrentSpace?.DisplayTitle ?? "Spaces")"
                @onclick="() => State.ToggleSpaceSwitcher(true)"
                @oncontextmenu="e => OpenShellMenu(e, ShellMenuKind.Space)"
                @oncontextmenu:preventDefault="true">
            @(State.CurrentSpace?.Initial ?? "S")
        </button>

        <button class="rail-item @(IsAt("") ? "active" : null)" title="Notes (Ctrl+K to jump)"
                @onclick='() => Go("")'
                @oncontextmenu="e => OpenShellMenu(e, ShellMenuKind.Notes)"
                @oncontextmenu:preventDefault="true">✎</button>
        <button class="rail-item @(IsAt("graph") ? "active" : null)" title="Graph"
                @onclick='() => Go("graph")'
                @oncontextmenu="e => OpenShellMenu(e, ShellMenuKind.Graph)"
                @oncontextmenu:preventDefault="true">◎</button>
        <button class="rail-item @(IsAt("settings") ? "active" : null)" title="Settings"
                @onclick='() => Go("settings")'
                @oncontextmenu="e => OpenShellMenu(e, ShellMenuKind.Settings)"
                @oncontextmenu:preventDefault="true">⚙</button>

        <div class="rail-spacer"></div>

        <div class="rail-dot @StatusClass" title="@SyncTooltip"
             @oncontextmenu="e => OpenShellMenu(e, ShellMenuKind.Sync)"
             @oncontextmenu:preventDefault="true"></div>
        <button type="button" class="rail-item" title="Toggle sidebar" @onclick="State.ToggleSidebar"
                @oncontextmenu="e => OpenShellMenu(e, ShellMenuKind.Sidebar)"
                @oncontextmenu:preventDefault="true">☰</button>
    </nav>

    <aside class="sidebar"
           @oncontextmenu="e => OpenShellMenu(e, ShellMenuKind.Sidebar)"
           @oncontextmenu:preventDefault="true">
        <div class="sidebar-head">
            <button type="button" class="sidebar-space" title="Switch space" @onclick="() => State.ToggleSpaceSwitcher(true)"
                    @oncontextmenu="e => OpenShellMenu(e, ShellMenuKind.Space)"
                    @oncontextmenu:preventDefault="true"
                    @oncontextmenu:stopPropagation="true">
                <span class="space-avatar sm" style="background: @(State.CurrentSpace?.Accent ?? SpaceColors.Default)">
                    @(State.CurrentSpace?.Initial ?? "S")
                </span>
                <span class="sidebar-title">@(State.CurrentSpace?.DisplayTitle ?? "Space")</span>
                <span class="sidebar-caret">▾</span>
            </button>
            <button class="chip primary" title="New page (Ctrl+N)" @onclick="() => NewPageAsync(null)">New</button>
        </div>

        <div class="sidebar-search" @oncontextmenu:stopPropagation="true">
            <input id="sidebar-search" placeholder="Search or Ctrl+K" value="@_query" @oninput="OnSearchAsync" />
        </div>

        @if (_tags.Count > 0 && _query.Length == 0)
        {
            <div class="sidebar-tags" @oncontextmenu:stopPropagation="true">
                @foreach (var tag in _tags)
                {
                    <button type="button"
                            class="tag-chip @(tag.Tag == _tagFilter ? "active" : null)"
                            title="@tag.Pages page(s)"
                            @onclick="() => ToggleTagAsync(tag.Tag)"
                            @oncontextmenu="e => OpenTagMenu(e, tag.Tag)"
                            @oncontextmenu:preventDefault="true">
                        #@tag.Tag
                    </button>
                }
            </div>
        }

        @if (_tagFilter is { } activeTag)
        {
            <div class="tree" @oncontextmenu:stopPropagation="true">
                @if (_tagPages.Count == 0)
                {
                    <div class="tree-empty">No pages tagged #@activeTag.</div>
                }
                else
                {
                    @foreach (var entry in _tagPages)
                    {
                        <button type="button"
                                class="tree-row flat @(entry.Id == State.CurrentPageId ? "selected" : null)"
                                @key="entry.Id"
                                @onclick="() => OpenTagPage(entry)"
                                @oncontextmenu="e => OpenTagPageMenu(e, entry)"
                                @oncontextmenu:preventDefault="true">
                            @if (!string.IsNullOrEmpty(entry.Icon))
                            {
                                <span class="tree-icon" aria-hidden="true">@entry.Icon</span>
                            }
                            <span class="tree-label">@entry.DisplayTitle</span>
                        </button>
                    }
                }
            </div>
        }
        else if (_hits is { Count: > 0 })
        {
            <div class="search-results" @oncontextmenu:stopPropagation="true">
                @foreach (var hit in _hits)
                {
                    <button class="search-hit" @key="hit.ObjectId + hit.BlockId" @onclick="() => OpenHit(hit)"
                            @oncontextmenu="e => OpenHitMenu(e, hit)"
                            @oncontextmenu:preventDefault="true">
                        <strong>@(string.IsNullOrWhiteSpace(hit.Title) ? "Untitled" : hit.Title)</strong>
                        <span>@((MarkupString)hit.Snippet)</span>
                    </button>
                }
            </div>
        }
        else if (_query.Length > 0)
        {
            <div class="tree-empty">Nothing matches “@_query”.</div>
        }
        else
        {
            <div class="tree" @oncontextmenu:stopPropagation="true">
                @if (State.Workspace.PagesIn(State.CurrentSpaceId).Count == 0)
                {
                    <div class="tree-empty"
                         @oncontextmenu="e => OpenShellMenu(e, ShellMenuKind.Sidebar)"
                         @oncontextmenu:preventDefault="true">
                        No pages yet. Use <strong>New</strong> above to create one.
                    </div>
                }
                else
                {
                    <PageTree Workspace="State.Workspace"
                              SelectedId="State.CurrentPageId"
                              OnSelect="Open"
                              OnAddChild="NewPageAsync" />
                }
            </div>
        }

        <div class="sidebar-foot" title="@SyncTooltip"
             @oncontextmenu="e => OpenShellMenu(e, ShellMenuKind.Sync)"
             @oncontextmenu:preventDefault="true"
             @oncontextmenu:stopPropagation="true">
            <span class="status-dot @StatusClass"></span>
            <span class="sidebar-foot-status grow">@SyncSummary</span>
            <button class="chip muted" title="Sync now (Ctrl+S)" @onclick="SyncNowAsync">↻</button>
            @if (Updater.Available is { } update)
            {
                <button class="chip primary update-chip"
                        disabled="@Updater.Busy"
                        title="Install Syncly @update.Version"
                        @onclick="UpdateAsync">
                    @(Updater.Busy ? (Updater.Progress ?? "Updating…") : $"Update {update.Version}")
                </button>
            }
        </div>
    </aside>

    @if (State.SidebarOpen)
    {
        <button type="button" class="sidebar-scrim" title="Close workspace" @onclick="() => State.SetSidebar(false)"></button>
    }

    <div class="shell-main">
        @Body
    </div>
</div>

@if (Updater.Available is { } banner && !IsAt("settings"))
{
    <div class="banner">
        <div>
            <div class="who">Syncly @banner.Version is ready</div>
            <div class="who">@(Updater.Progress ?? "Update downloads in the background.")</div>
        </div>
        <div class="row">
            <button class="chip primary" disabled="@Updater.Busy" @onclick="UpdateAsync">
                @(Updater.Busy ? "Updating…" : "Update")
            </button>
        </div>
    </div>
}

@if (State.PaletteOpen)
{
    <Palette Items="PaletteItems()"
             Placeholder="Jump, search, or run a command"
             InputId="command-palette"
             OnQuery="OnPaletteQuery"
             OnClose="ClosePalette" />
}

@if (State.SpaceSwitcherOpen)
{
    <SpaceSwitcher OnClose="() => State.ToggleSpaceSwitcher(false)" />
}

@if (_shellMenu is not null)
{
    <ContextMenu Items="_shellMenu.Items"
                 Left="_shellMenu.Left"
                 Top="_shellMenu.Top"
                 OnClose="CloseShellMenu" />
}

@code {
    private enum ShellMenuKind { Space, Notes, Graph, Settings, Sync, Sidebar }

    private sealed record ShellMenuState(double Left, double Top, IReadOnlyList<ContextMenu.MenuItem> Items);

    private DotNetObjectReference<MainLayout>? _self;
    private CancellationTokenSource? _updateCts;
    private string _query = string.Empty;
    private List<SearchHit>? _hits;
    private bool _paletteFlag;
    private List<string> _unresolved = [];
    private List<SearchHit> _paletteHits = [];
    private List<TagCount> _tags = [];
    private string? _tagFilter;
    private List<PageRef> _tagPages = [];
    private ShellMenuState? _shellMenu;

    protected override void OnInitialized()
    {
        State.Changed += Refresh;
        State.Workspace.Changed += Refresh;
        App.Sync.Changed += Refresh;
        Updater.Changed += Refresh;
        _ = LoadTagsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("syncly.attachShell", _self);
            await State.Workspace.RefreshPagesAsync();
            _updateCts = new CancellationTokenSource();
            _ = PollUpdatesAsync(_updateCts.Token);

            if (await Js.InvokeAsync<bool>("syncly.isNarrow"))
                State.SetSidebar(false);
        }

        if (_paletteFlag != State.PaletteOpen)
        {
            _paletteFlag = State.PaletteOpen;
            try
            {
                await Js.InvokeVoidAsync("syncly.setPaletteOpen", State.PaletteOpen);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private void Refresh() => InvokeAsync(async () =>
    {
        try
        {
            _unresolved = await State.Workspace.UnresolvedLinksAsync();
        }
        catch
        {
            _unresolved = [];
        }

        await LoadTagsAsync();
        if (_tagFilter is { } tag)
            _tagPages = await State.Workspace.PagesWithTagAsync(tag);

        StateHasChanged();
    });

    private async Task LoadTagsAsync() => _tags = await State.Workspace.TagsAsync();

    private async Task ToggleTagAsync(string tag)
    {
        if (_tagFilter == tag)
        {
            _tagFilter = null;
            _tagPages = [];
            return;
        }

        _tagFilter = tag;
        _tagPages = await State.Workspace.PagesWithTagAsync(tag);
    }

    private void OpenTagPage(PageRef page)
    {
        State.Open(page.Id);
        _tagFilter = null;
        _tagPages = [];
        _ = CloseSidebarIfNarrowAsync();
    }

    private bool IsAt(string path) =>
        Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/').Equals(path, StringComparison.OrdinalIgnoreCase);

    private void Go(string path)
    {
        Nav.NavigateTo(path);
        _ = CloseSidebarIfNarrowAsync();
        StateHasChanged();
    }

    private void Open(string pageId)
    {
        State.Open(pageId);
        _query = string.Empty;
        _hits = null;

        if (!IsAt(""))
            Nav.NavigateTo("");

        _ = CloseSidebarIfNarrowAsync();
    }

    private void OpenHit(SearchHit hit)
    {
        State.Open(hit.ObjectId, string.IsNullOrEmpty(hit.BlockId) ? null : hit.BlockId);
        _query = string.Empty;
        _hits = null;

        if (!IsAt(""))
            Nav.NavigateTo("");

        _ = CloseSidebarIfNarrowAsync();
    }

    private async Task CloseSidebarIfNarrowAsync()
    {
        if (await Js.InvokeAsync<bool>("syncly.isNarrow"))
            State.SetSidebar(false);
    }

    private async Task NewPageAsync(string? parentId)
    {
        if (parentId is not null)
            State.ExpandPage(parentId);

        var pageId = await State.Workspace.CreatePageAsync(parentId);
        Open(pageId);
        State.SetReadingMode(false);
    }

    private async Task OnSearchAsync(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        _hits = _query.Trim().Length == 0
            ? null
            : await State.Workspace.SearchAsync(_query);
    }

    private async Task OnPaletteQuery(string query)
    {
        _paletteHits = query.Trim().Length == 0
            ? []
            : await State.Workspace.SearchAsync(query);
        StateHasChanged();
    }

    private void ClosePalette()
    {
        _paletteHits = [];
        State.TogglePalette(false);
    }

    private async Task OpenDailyAsync()
    {
        var pageId = await State.Workspace.OpenOrCreateDailyAsync();
        Open(pageId);
        State.SetReadingMode(false);
    }

    private async Task DuplicateCurrentAsync(string pageId)
    {
        var copyId = await State.Workspace.DuplicatePageAsync(pageId);
        Open(copyId);
        State.SetReadingMode(false);
    }

    private Task SyncNowAsync() => App.Sync.SyncNowAsync();

    private Task UpdateAsync() => Updater.ApplyAsync();

    private async Task PollUpdatesAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await Updater.CheckAsync(ct);
                await Task.Delay(TimeSpan.FromHours(6), ct);
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch
            {
                try
                {
                    await Task.Delay(TimeSpan.FromHours(1), ct);
                }
                catch (OperationCanceledException)
                {
                    return;
                }
            }
        }
    }

    private string StatusClass => App.Sync.Status.Phase switch
    {
        SyncPhase.Idle when App.Sync.IsConfigured => "live",
        SyncPhase.Failed => "failed",
        SyncPhase.Syncing => "working",
        _ => "",
    };

    private string SyncSummary => App.Sync.Status.Summary;

    private void OpenShellMenu(MouseEventArgs e, ShellMenuKind kind)
    {
        _shellMenu = new(e.ClientX, e.ClientY, ShellMenuItems(kind));
    }

    private void OpenTagMenu(MouseEventArgs e, string tag)
    {
        _shellMenu = new(e.ClientX, e.ClientY,
        [
            new(_tagFilter == tag ? "Clear tag filter" : "Filter by tag", () => ToggleTagAsync(tag), "#"),
            new("New page", () => NewPageAsync(null), "+"),
            new("Sync now", SyncNowAsync, "↻"),
        ]);
    }

    private void OpenTagPageMenu(MouseEventArgs e, PageRef page)
    {
        _shellMenu = new(e.ClientX, e.ClientY,
        [
            new("Open", () => { OpenTagPage(page); return Task.CompletedTask; }, "↗"),
            new("Duplicate", async () =>
            {
                var copyId = await State.Workspace.DuplicatePageAsync(page.Id);
                Open(copyId);
            }, "⧉"),
            new("Clear tag filter", async () =>
            {
                _tagFilter = null;
                _tagPages = [];
                await Task.CompletedTask;
            }, "#"),
        ]);
    }

    private void OpenHitMenu(MouseEventArgs e, SearchHit hit)
    {
        _shellMenu = new(e.ClientX, e.ClientY,
        [
            new("Open", () => { OpenHit(hit); return Task.CompletedTask; }, "↗"),
            new("Clear search", () =>
            {
                _query = string.Empty;
                _hits = null;
                return Task.CompletedTask;
            }, "✕"),
        ]);
    }

    private Task CloseShellMenu()
    {
        _shellMenu = null;
        return Task.CompletedTask;
    }

    private IReadOnlyList<ContextMenu.MenuItem> ShellMenuItems(ShellMenuKind kind) => kind switch
    {
        ShellMenuKind.Space =>
        [
            new("Switch space", () => { State.ToggleSpaceSwitcher(true); return Task.CompletedTask; }, "▣"),
            new("New page", () => NewPageAsync(null), "+"),
            new("Today's note", OpenDailyAsync, "📅"),
        ],
        ShellMenuKind.Notes =>
        [
            new("Open notes", () => { Go(""); return Task.CompletedTask; }, "✎"),
            new("New page", () => NewPageAsync(null), "+"),
            new("Command palette", () => { State.TogglePalette(true); return Task.CompletedTask; }, "⌘"),
            new(State.ReadingMode ? "Edit mode" : "Reading mode", () =>
            {
                State.ToggleReadingMode();
                return Task.CompletedTask;
            }, "👁"),
        ],
        ShellMenuKind.Graph =>
        [
            new("Open graph", () => { Go("graph"); return Task.CompletedTask; }, "◎"),
            new("New page", () => NewPageAsync(null), "+"),
        ],
        ShellMenuKind.Settings =>
        [
            new("Open settings", () => { Go("settings"); return Task.CompletedTask; }, "⚙"),
            new("Sync now", SyncNowAsync, "↻"),
        ],
        ShellMenuKind.Sync =>
        [
            new("Sync now", SyncNowAsync, "↻"),
            new("Open settings", () => { Go("settings"); return Task.CompletedTask; }, "⚙"),
            ..(Updater.Available is not null
                ? new ContextMenu.MenuItem[] { new("Install update", UpdateAsync, "↑") }
                : []),
        ],
        _ =>
        [
            new("New page", () => NewPageAsync(null), "+"),
            new("Today's note", OpenDailyAsync, "📅"),
            new("Switch space", () => { State.ToggleSpaceSwitcher(true); return Task.CompletedTask; }, "▣"),
            new("Sync now", SyncNowAsync, "↻"),
            new(State.SidebarOpen ? "Hide sidebar" : "Show sidebar", () =>
            {
                State.ToggleSidebar();
                return Task.CompletedTask;
            }, "☰"),
            new("Open graph", () => { Go("graph"); return Task.CompletedTask; }, "◎"),
            new("Open settings", () => { Go("settings"); return Task.CompletedTask; }, "⚙"),
        ],
    };

    private string SyncTooltip =>
        App.Sync.Status.Detail is { Length: > 0 } detail
            ? $"{App.Sync.Status.Summary} — {detail}"
            : App.Sync.Status.Summary;

    private IReadOnlyList<Palette.PaletteItem> PaletteItems()
    {
        var items = new List<Palette.PaletteItem>
        {
            new("+", "New page", "Ctrl+N", () => NewPageAsync(null)),
            new("▣", "New space", null, () =>
            {
                State.ToggleSpaceSwitcher(true);
                return Task.CompletedTask;
            }),
            new("◎", "Graph", null, () =>
            {
                Go("graph");
                return Task.CompletedTask;
            }),
            new("↻", "Sync now", "Ctrl+S", SyncNowAsync),
            new("📅", "Today's note", "Ctrl+D", OpenDailyAsync),
            new("👁", State.ReadingMode ? "Edit this page" : "Reading mode", "Ctrl+E", () =>
            {
                State.ToggleReadingMode();
                return Task.CompletedTask;
            }),
            new("⚙", "Settings", null, () =>
            {
                Go("settings");
                return Task.CompletedTask;
            }),
        };

        if (State.CurrentPageId is { } current)
        {
            items.Add(new("⧉", "Duplicate this page", null, () => DuplicateCurrentAsync(current)));
        }

        items.AddRange(_paletteHits
            .Where(hit => hit.BlockId.Length > 0)
            .Select(hit =>
            {
                var snippet = SearchBody.PlainSnippet(hit.Snippet);
                if (snippet.Length > 80)
                    snippet = snippet[..80] + "…";
                var title = string.IsNullOrWhiteSpace(hit.Title) ? "Untitled" : hit.Title;
                return new Palette.PaletteItem(
                    "⌕",
                    title,
                    snippet,
                    () =>
                    {
                        OpenHit(hit);
                        return Task.CompletedTask;
                    },
                    Pin: true);
            }));

        items.AddRange(_unresolved.Take(20).Select(title =>
            new Palette.PaletteItem(
                "?",
                title,
                "Missing page",
                async () =>
                {
                    var pageId = await State.Workspace.EnsurePageByTitleAsync(title);
                    Open(pageId);
                })));

        items.AddRange(State.Workspace.PagesIn(State.CurrentSpaceId).Select(page =>
            new Palette.PaletteItem(
                page.Icon is { Length: > 0 } icon ? icon : "◻",
                page.DisplayTitle,
                "Page",
                () =>
                {
                    Open(page.Id);
                    return Task.CompletedTask;
                })));

        return items;
    }

    [JSInvokable]
    public void OnPalette() => State.TogglePalette();

    [JSInvokable]
    public void OnToggleReading() => State.ToggleReadingMode();

    [JSInvokable]
    public Task OnNewPage() => NewPageAsync(null);

    [JSInvokable]
    public Task OnSyncNow() => SyncNowAsync();

    [JSInvokable]
    public Task OnDailyNote() => OpenDailyAsync();

    [JSInvokable]
    public async Task OnFind()
    {
        State.SetSidebar(true);
        State.TogglePalette(false);
        try
        {
            await Js.InvokeVoidAsync("syncly.focusElement", "sidebar-search", true);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public void OnEscape()
    {
        _paletteHits = [];
        _shellMenu = null;
        State.TogglePalette(false);
        State.ToggleSpaceSwitcher(false);
    }

    [JSInvokable]
    public async Task OnOpenLink(string title)
    {
        if (string.IsNullOrWhiteSpace(title))
            return;

        var pageId = State.Workspace.ResolvePageByTitle(title)
                     ?? await State.Workspace.EnsurePageByTitleAsync(title);

        Open(pageId);
    }

    public sealed record LinkPreviewInfo(string Title, bool Missing, IReadOnlyList<string> Lines);

    [JSInvokable]
    public async Task<LinkPreviewInfo> OnLinkPreview(string title)
    {
        var pageId = State.Workspace.ResolvePageByTitle(title);
        if (pageId is null)
            return new LinkPreviewInfo(title, true, []);

        var preview = await State.Workspace.PreviewAsync(pageId, 3);
        return new LinkPreviewInfo(preview?.Title ?? title, false, preview?.Lines ?? []);
    }

    public void Dispose()
    {
        _updateCts?.Cancel();
        _updateCts?.Dispose();
        State.Changed -= Refresh;
        State.Workspace.Changed -= Refresh;
        App.Sync.Changed -= Refresh;
        Updater.Changed -= Refresh;
        _self?.Dispose();
    }
}
