@namespace Syncly.UI.Components
@inject EditorState State
@inject IJSRuntime Js

<div class="overlay" @onclick="Close">
    <div class="dialog space-switcher"
         id="space-switcher"
         tabindex="-1"
         @onclick:stopPropagation="true"
         @onkeydown="OnKeyDown">
        <div class="dialog-head">
            <div>
                <div class="dialog-kicker">Spaces</div>
                <div class="dialog-title">Where you work</div>
            </div>
            <button class="chip muted" @onclick="Close">Close</button>
        </div>

        <div class="dialog-body">
            <div class="space-grid">
                @foreach (var space in State.Workspace.Spaces)
                {
                    <div class="space-card-wrap" @key="space.Id"
                         @oncontextmenu="e => OpenSpaceMenu(e, space)"
                         @oncontextmenu:preventDefault="true">
                        <button type="button"
                                class="space-card @(space.Id == State.CurrentSpaceId ? "active" : null)"
                                @onclick="() => SwitchAsync(space.Id)">
                            <span class="space-avatar lg" style="background: @space.Accent">@space.Initial</span>
                            <span class="space-card-name">@(space.DisplayTitle)</span>
                            <span class="space-card-meta">@CountLabel(space.Id)</span>
                        </button>
                        <button type="button"
                                class="space-card-edit"
                                title="Edit space"
                                aria-label="Edit space"
                                @onclick="() => BeginEdit(space)">
                            <Icon Name="edit" />
                        </button>
                    </div>
                }

                <button type="button" class="space-card create" @onclick="BeginCreate">
                    <span class="space-avatar lg ghost"><Icon Name="add" /></span>
                    <span class="space-card-name">New space</span>
                    <span class="space-card-meta">A separate set of pages</span>
                </button>
            </div>

            @if (_creating)
            {
                <div class="space-create">
                    <div class="space-create-kicker">New space</div>
                    <input placeholder="Space name"
                           value="@_name"
                           @oninput="e => _name = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="OnCreateKeyDown" />
                    <div class="space-colors">
                        @foreach (var color in SpaceColors.All)
                        {
                            <button type="button"
                                    class="space-swatch @(_color == color ? "picked" : null)"
                                    style="background: @color"
                                    title="@color"
                                    @onclick="() => _color = color"></button>
                        }
                    </div>
                    <div class="row">
                        <button class="chip" @onclick="CancelPanels">Cancel</button>
                        <button class="chip primary" @onclick="CreateAsync">Create</button>
                    </div>
                </div>
            }
            else if (_editing is { } editing)
            {
                <div class="space-create">
                    <div class="space-create-kicker">Edit space</div>
                    <input placeholder="Space name"
                           value="@_name"
                           @oninput="e => _name = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="OnEditKeyDown" />
                    <div class="space-colors">
                        @foreach (var color in SpaceColors.All)
                        {
                            <button type="button"
                                    class="space-swatch @(_color == color ? "picked" : null)"
                                    style="background: @color"
                                    title="@color"
                                    @onclick="() => _color = color"></button>
                        }
                    </div>
                    <div class="row wrap">
                        <button class="chip" @onclick="CancelPanels">Cancel</button>
                        <button class="chip primary" @onclick="SaveEditAsync">Save</button>
                        @if (editing.Id != DefaultSpaceId)
                        {
                            @if (_confirmDelete)
                            {
                                <button class="chip danger" @onclick="DeleteAsync">Delete forever</button>
                            }
                            else
                            {
                                <button class="chip danger" @onclick="() => _confirmDelete = true">Delete…</button>
                            }
                        }
                    </div>
                    @if (_confirmDelete && editing.Id != DefaultSpaceId)
                    {
                        <div class="space-create-hint">
                            Pages move to @(State.Workspace.Space(DefaultSpaceId)?.DisplayTitle ?? "Private").
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="space-create-hint danger">@_error</div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (_menuSpace is not null)
{
    <ContextMenu Items="SpaceMenuItems()"
                 Left="_menuLeft"
                 Top="_menuTop"
                 OnClose="CloseSpaceMenu" />
}

@code {
    private const string DefaultSpaceId = Syncly.App.Workspace.DefaultSpaceId;

    private bool _creating;
    private PageRef? _editing;
    private bool _confirmDelete;
    private string _name = string.Empty;
    private string _color = SpaceColors.Default;
    private string? _error;
    private PageRef? _menuSpace;
    private double _menuLeft;
    private double _menuTop;

    [Parameter]
    public EventCallback OnClose { get; set; }

    private Task Close() => OnClose.InvokeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Js.InvokeVoidAsync("syncly.focusElement", "space-switcher", false);
    }

    /// <summary>Escape backs out of an open form first, then out of the dialog.</summary>
    private Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape")
            return Task.CompletedTask;

        if (_creating || _editing is not null)
        {
            CancelPanels();
            return Task.CompletedTask;
        }

        return Close();
    }

    private void OpenSpaceMenu(MouseEventArgs e, PageRef space)
    {
        _menuSpace = space;
        _menuLeft = e.ClientX;
        _menuTop = e.ClientY;
    }

    private Task CloseSpaceMenu()
    {
        _menuSpace = null;
        return Task.CompletedTask;
    }

    private IReadOnlyList<ContextMenu.MenuItem> SpaceMenuItems()
    {
        var space = _menuSpace;
        if (space is null)
            return [];

        var items = new List<ContextMenu.MenuItem>
        {
            new("Open", () => SwitchAsync(space.Id), "open_in_new"),
            new("Edit", () => { BeginEdit(space); return Task.CompletedTask; }, "edit"),
        };

        if (space.Id != DefaultSpaceId)
        {
            items.Add(new("Delete…", () =>
            {
                BeginEdit(space);
                _confirmDelete = true;
                return Task.CompletedTask;
            }, "delete", Danger: true));
        }

        return items;
    }

    private void CancelPanels()
    {
        _creating = false;
        _editing = null;
        _confirmDelete = false;
        _error = null;
        _name = string.Empty;
        _color = SpaceColors.Default;
    }

    private void BeginCreate()
    {
        _editing = null;
        _confirmDelete = false;
        _error = null;
        _creating = true;
        _name = string.Empty;
        _color = SpaceColors.Default;
    }

    private void BeginEdit(PageRef space)
    {
        _creating = false;
        _confirmDelete = false;
        _error = null;
        _editing = space;
        _name = space.Title;
        _color = space.Accent;
    }

    private async Task SwitchAsync(string spaceId)
    {
        await State.SwitchSpaceAsync(spaceId);
        await Close();
    }

    private async Task CreateAsync()
    {
        var title = string.IsNullOrWhiteSpace(_name) ? "Untitled space" : _name.Trim();
        await State.CreateSpaceAsync(title, _color);
        CancelPanels();
        await Close();
    }

    private async Task SaveEditAsync()
    {
        if (_editing is null)
            return;

        var title = string.IsNullOrWhiteSpace(_name) ? "Untitled space" : _name.Trim();
        var spaceId = _editing.Id;

        if (!string.Equals(title, _editing.Title, StringComparison.Ordinal))
            await State.RenameSpaceAsync(spaceId, title);

        if (!string.Equals(_color, _editing.Accent, StringComparison.OrdinalIgnoreCase))
            await State.SetSpaceColorAsync(spaceId, _color);

        CancelPanels();
    }

    private async Task DeleteAsync()
    {
        if (_editing is null || _editing.Id == DefaultSpaceId)
            return;

        try
        {
            await State.DeleteSpaceAsync(_editing.Id);
            CancelPanels();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private Task OnCreateKeyDown(KeyboardEventArgs args) =>
        args.Key == "Enter" ? CreateAsync() : args.Key == "Escape" ? CancelAndMaybeClose() : Task.CompletedTask;

    private Task OnEditKeyDown(KeyboardEventArgs args) =>
        args.Key == "Enter" ? SaveEditAsync() : args.Key == "Escape" ? CancelAndMaybeClose() : Task.CompletedTask;

    private Task CancelAndMaybeClose()
    {
        CancelPanels();
        return Task.CompletedTask;
    }

    private string CountLabel(string spaceId)
    {
        var count = State.Workspace.PagesIn(spaceId).Count;
        return count == 1 ? "1 page" : $"{count} pages";
    }
}
