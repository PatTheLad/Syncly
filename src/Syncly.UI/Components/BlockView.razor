@namespace Syncly.UI.Components
@implements IAsyncDisposable
@implements IDisposable
@inject IJSRuntime Js
@inject EditorState State

<div id="@ElementId"
     class="block @KindClass @BlockDropClass"
     @key="Block.Id"
     @ondragover="OnDragOverAsync"
     @ondragover:preventDefault
     @ondrop="OnDropAsync"
     @ondrop:preventDefault>
    @if (!Host.Reading && Block.Kind is not (BlockKind.Divider or BlockKind.PageLink or BlockKind.File))
    {
        <button class="block-handle"
                title="Drag to reorder, click for actions"
                draggable="true"
                @onclick="OpenMenuAsync"
                @ondragstart="OnDragStart"
                @ondragend="OnDragEnd">⋮</button>
    }

    @if (Block.Kind == BlockKind.Todo)
    {
        <button class="checkbox @(Block.Checked ? "checked" : null)"
                title="Toggle"
                @onclick="() => Host.ToggleTodoAsync(Block.Id)">
            @(Block.Checked ? "✓" : "")
        </button>
    }
    else if (Block.Kind == BlockKind.Bullet)
    {
        <span class="block-marker">•</span>
    }
    else if (Block.Kind == BlockKind.Numbered)
    {
        <span class="block-marker">@(NumberedMarker).</span>
    }

    @if (Block.Kind == BlockKind.Divider)
    {
        <hr />
    }
    else if (Block.Kind == BlockKind.PageLink)
    {
        <button type="button"
                class="page-link-card"
                title="Open page"
                @onclick="OpenTargetAsync">
            <span class="page-link-icon" aria-hidden="true">@LinkIcon</span>
            <span class="page-link-title">@LinkTitle</span>
            <span class="page-link-hint">Open</span>
        </button>
        @if (!Host.Reading)
        {
            <button type="button"
                    class="block-handle page-link-menu"
                    title="Block actions"
                    @onclick="OpenMenuAsync">⋮</button>
        }
    }
    else if (Block.Kind == BlockKind.File)
    {
        <div class="file-block">
            @if (_missing)
            {
                <div class="file-card">
                    <span class="file-card-icon">@FileIcon</span>
                    <div class="file-card-body">
                        <strong>@(Block.FileName ?? "Attachment")</strong>
                        <span>Waiting for file to sync…</span>
                    </div>
                </div>
            }
            else if (Preview == FilePreviewKind.Image && _objectUrl is not null)
            {
                <button type="button"
                        class="file-media-btn"
                        title="Open @(Block.FileName ?? "image")"
                        @onclick="() => Host.OpenAttachedFileAsync(Block.Id)">
                    <img class="file-media" src="@_objectUrl" alt="@(Block.FileName ?? "Image")" />
                </button>
            }
            else if (Preview == FilePreviewKind.Video && _objectUrl is not null)
            {
                <video class="file-media" controls src="@_objectUrl"></video>
                <button type="button" class="chip muted" @onclick="() => Host.OpenAttachedFileAsync(Block.Id)">Open</button>
            }
            else if (NeedsInlinePreview)
            {
                <div class="file-pending">Loading…</div>
            }
            else
            {
                <button type="button" class="file-card" @onclick="() => Host.OpenAttachedFileAsync(Block.Id)">
                    <span class="file-card-icon">@FileIcon</span>
                    <div class="file-card-body">
                        <strong>@(Block.FileName ?? "Attachment")</strong>
                        <span>@SizeLabel · @(Block.Mime ?? "file")</span>
                    </div>
                    <span class="page-link-hint">Open</span>
                </button>
            }
            @if (Host.Reading)
            {
                @if (Block.Text.Length > 0)
                {
                    <div class="file-caption">@((MarkupString)InlineMarkup.ToHtml(Block.Text, Host.ResolveLink))</div>
                }
            }
            else
            {
                <div @ref="_element"
                     class="file-caption block-text"
                     contenteditable="true"
                     spellcheck="true"
                     data-placeholder="Caption"></div>
            }
        </div>
        @if (!Host.Reading)
        {
            <button type="button"
                    class="block-handle page-link-menu"
                    title="Block actions"
                    @onclick="OpenMenuAsync">⋮</button>
        }
    }
    else if (Block.Kind == BlockKind.Code)
    {
        <div class="code-shell">
            @if (Host.Reading)
            {
                <span class="code-lang">@CodeHighlight.Label(Block.Language)</span>
            }
            else
            {
                <button type="button"
                        class="code-lang"
                        title="Code language"
                        @onclick:stopPropagation="true"
                        @onclick="() => Host.PickCodeLanguageAsync(Block.Id)">
                    @CodeHighlight.Label(Block.Language)
                </button>
            }
            @if (Host.Reading)
            {
                <div class="block-text"
                     title="Double-click to edit"
                     @ondblclick="() => Host.EditAtAsync(Block.Id)">
                    @((MarkupString)CodeHighlight.ToHtml(Block.Text, Block.Language))
                </div>
            }
            else if (!ShowsSource)
            {
                <div class="block-text block-preview"
                     title="Click to edit"
                     @onclick="() => Host.FocusAsync(Block.Id)">
                    @((MarkupString)CodeHighlight.ToHtml(Block.Text, Block.Language))
                </div>
            }
            else
            {
                <div @ref="_element"
                     class="block-text"
                     contenteditable="true"
                     spellcheck="false"
                     data-placeholder="@Placeholder"></div>
            }
        </div>
    }
    else if (Host.Reading)
    {
        <div class="block-text @(Block.Checked ? "done" : null)"
             title="Double-click to edit"
             @ondblclick="() => Host.EditAtAsync(Block.Id)">
            @((MarkupString)InlineMarkup.ToHtml(Block.Text, Host.ResolveLink))
        </div>
    }
    else if (!ShowsSource)
    {
        <div class="block-text block-preview @(Block.Checked ? "done" : null)"
             title="Click to edit"
             @onclick="() => Host.FocusAsync(Block.Id)">
            @((MarkupString)InlineMarkup.ToHtml(Block.Text, Host.ResolveLink))
        </div>
    }
    else
    {
        <div @ref="_element"
             class="block-text @(Block.Checked ? "done" : null)"
             contenteditable="true"
             spellcheck="true"
             data-placeholder="@Placeholder"></div>
    }
</div>

@if (Block.Children.Count > 0)
{
    <div class="block-children">
        @for (var i = 0; i < Block.Children.Count; i++)
        {
            var child = Block.Children[i];
            <BlockView Block="child" Index="i" Host="Host" @key="child.Id" />
        }
    </div>
}

@code {
    private ElementReference _element;
    private DotNetObjectReference<BlockView>? _self;
    private string? _echo;
    private string _pushed = "";
    private bool _attached;
    private bool _wasSource;
    private string? _objectUrl;
    private string? _loadedFileId;
    private bool _loading;
    private bool _missing;
    private bool _reloadQueued;

    [Parameter, EditorRequired]
    public required BlockNode Block { get; set; }

    [Parameter]
    public int Index { get; set; }

    [Parameter, EditorRequired]
    public required IBlockHost Host { get; set; }

    public string ElementId => $"blk-{Block.Id}";

    private int NumberedMarker =>
        Block.Kind == BlockKind.Numbered
            ? State.Workspace.Tree(Block.ObjectId).NumberedMarker(Block)
            : Index + 1;

    private string? BlockDropClass => Host.BlockDropClass(Block.Id);

    /// <summary>
    /// Source (markers visible) only for the focused text block, or a file caption while editing.
    /// Everyone else renders formatted HTML.
    /// </summary>
    private bool ShowsSource =>
        Block.Kind == BlockKind.File
            ? !Host.Reading
            : !Host.Reading && Host.FocusedBlockId == Block.Id;

    private PageRef? TargetPage =>
        Block.Target is { Length: > 0 } target ? State.Workspace.Page(target) : null;

    private string LinkTitle =>
        TargetPage?.DisplayTitle
        ?? (string.IsNullOrWhiteSpace(Block.Text) ? "Untitled" : Block.Text);

    private string LinkIcon =>
        TargetPage?.Icon is { Length: > 0 } icon ? icon : "↗";

    private FilePreviewKind Preview => FilePreview.ForMime(Block.Mime);

    private bool NeedsInlinePreview =>
        Preview is FilePreviewKind.Image or FilePreviewKind.Video;

    private string FileIcon => FilePreview.CardIcon(Block.Mime, Block.FileName);

    private string SizeLabel =>
        Block.ByteSize is { } size
            ? size >= 1024 * 1024
                ? $"{size / (1024.0 * 1024.0):0.#} MB"
                : $"{Math.Max(1, size / 1024)} KB"
            : "file";

    private string KindClass => Block.Kind switch
    {
        BlockKind.Heading1 => "h1",
        BlockKind.Heading2 => "h2",
        BlockKind.Heading3 => "h3",
        BlockKind.Bullet => "bullet",
        BlockKind.Numbered => "numbered",
        BlockKind.Todo => "todo",
        BlockKind.Quote => "quote",
        BlockKind.Code => "code",
        BlockKind.Divider => "divider",
        BlockKind.PageLink => "page-link",
        BlockKind.File => "file",
        _ => "paragraph",
    };

    private string Placeholder => Block.Kind switch
    {
        BlockKind.Heading1 or BlockKind.Heading2 or BlockKind.Heading3 => "Heading",
        BlockKind.Code => CodeHighlight.Label(Block.Language),
        BlockKind.Quote => "Quote",
        BlockKind.File => "Caption",
        _ => "Type '/' for commands",
    };

    protected override void OnParametersSet()
    {
        if (Block.Kind != BlockKind.File || NeedsInlinePreview || Block.FileId is not { Length: > 0 } fileId)
            return;

        _loadedFileId = fileId;
        _loading = false;
        _missing = !Host.HasAttachedFile(fileId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Block.Kind != BlockKind.File || Block.FileId is not { Length: > 0 } fileId)
            return;

        if (!NeedsInlinePreview)
        {
            if (_objectUrl is not null)
                await RevokeUrlAsync();
            return;
        }

        if (_loadedFileId == fileId && _objectUrl is not null)
            return;

        if (_loading)
        {
            _reloadQueued = true;
            return;
        }

        await LoadFileAsync(fileId);
    }

    private async Task LoadFileAsync(string fileId)
    {
        _loading = true;
        _reloadQueued = false;
        _missing = false;
        try
        {
            await RevokeUrlAsync();
            _loadedFileId = fileId;

            var url = await Host.ResolveFileObjectUrlAsync(fileId, Block.Mime ?? "application/octet-stream");
            if (url is null)
                _missing = true;
            else
                _objectUrl = url;
        }
        catch
        {
            _missing = true;
        }
        finally
        {
            _loading = false;
        }

        if (_reloadQueued && _objectUrl is null)
            await LoadFileAsync(fileId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Block.Kind is BlockKind.Divider or BlockKind.PageLink)
        {
            _attached = false;
            return;
        }

        if (!ShowsSource)
        {
            _attached = false;
            _wasSource = false;
            _pushed = Block.Text;
            _echo = null;
            return;
        }

        if (!_attached || !_wasSource)
        {
            _self ??= DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("syncly.attachBlock", _element, _self, Block.Id);
            await Js.InvokeVoidAsync("syncly.setText", ElementId, Block.Text, -1);
            _pushed = Block.Text;
            _echo = null;
            _attached = true;
            _wasSource = true;
            return;
        }

        if (_echo is not null)
        {
            if (!string.Equals(_echo, Block.Text, StringComparison.Ordinal))
                return;

            _echo = null;
            _pushed = Block.Text;
            return;
        }

        if (!string.Equals(_pushed, Block.Text, StringComparison.Ordinal))
        {
            await Js.InvokeVoidAsync("syncly.setText", ElementId, Block.Text, -1);
            _pushed = Block.Text;
        }
    }

    [JSInvokable]
    public Task OnInput(string text, int caret)
    {
        _echo = text;
        return Host.TextChangedAsync(Block.Id, text, caret);
    }

    [JSInvokable]
    public Task OnFocus() => Host.FocusAsync(Block.Id);

    [JSInvokable]
    public Task OnBlur(string text) => Host.BlurAsync(Block.Id, text);

    [JSInvokable]
    public Task OnSplit(string text, int caret) => Host.SplitAsync(Block.Id, text, caret);

    [JSInvokable]
    public Task OnMergeBackward() => Host.MergeBackwardAsync(Block.Id);

    [JSInvokable]
    public Task OnMergeForward() => Host.MergeForwardAsync(Block.Id);

    [JSInvokable]
    public Task OnIndent(bool indent) => Host.IndentAsync(Block.Id, indent);

    [JSInvokable]
    public Task OnMoveBlock(bool up) => Host.MoveAsync(Block.Id, up);

    [JSInvokable]
    public Task OnStep(bool down, int caret) => Host.StepAsync(Block.Id, down, caret);

    [JSInvokable]
    public Task OnMark(string shortcut, string text, int start, int end) =>
        Host.MarkAsync(Block.Id, shortcut, text, start, end);

    [JSInvokable]
    public Task OnPasteFiles() => Host.PrepareAttachAfterAsync(Block.Id);

    [JSInvokable]
    public Task OnSlash() => Host.SlashAsync(Block.Id);

    [JSInvokable]
    public Task OnMenuKey(string key) => Host.MenuKeyAsync(key);

    [JSInvokable]
    public Task OnEscape() => Host.EscapeAsync();

    private Task OpenMenuAsync() => Host.SlashAsync(Block.Id);

    private void OnDragStart() => Host.BeginBlockDrag(Block.Id);

    private void OnDragEnd() => Host.EndBlockDrag();

    private Task OnDragOverAsync(DragEventArgs e) => Host.BlockDragOverAsync(Block.Id, e);

    private Task OnDropAsync(DragEventArgs e) => Host.DropBlockAsync(Block.Id, e);

    private Task OpenTargetAsync()
    {
        if (Block.Target is { Length: > 0 } target)
            return Host.OpenPageAsync(target);

        return Task.CompletedTask;
    }

    private async Task RevokeUrlAsync()
    {
        if (_objectUrl is null)
            return;

        try
        {
            await Js.InvokeVoidAsync("syncly.revokeObjectUrl", _objectUrl);
        }
        catch (JSDisconnectedException)
        {
        }

        _objectUrl = null;
    }

    public async ValueTask DisposeAsync()
    {
        await RevokeUrlAsync();
        _self?.Dispose();
    }

    public void Dispose() => _self?.Dispose();
}
