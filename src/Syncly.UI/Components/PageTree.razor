@namespace Syncly.UI.Components
@inject EditorState State
@inject IJSRuntime Js

<div class="tree-drop @(_dropRoot ? "drop-hover" : null)"
     @ondragover="OnRootDragOver"
     @ondragover:preventDefault
     @ondrop="OnRootDrop"
     @oncontextmenu="OnTreeContext"
     @oncontextmenu:preventDefault="true">
@foreach (var (page, depth, childCount) in VisibleRows())
{
    var id = page.Id;
    var expanded = State.IsPageExpanded(id);
    var renaming = _renamingId == id;
    var selected = id == SelectedId;

    <div @key="id"
         class="tree-row @(selected ? "selected" : null) @RowDropClass(id)"
         style="padding-left: @(8 + depth * 18)px"
         draggable="@(renaming ? "false" : "true")"
         data-page="@id"
         tabindex="0"
         @onclick="() => OnSelect.InvokeAsync(id)"
         @onkeydown="e => OnRowKey(id, e)"
         @oncontextmenu="e => OpenMenu(id, e)"
         @oncontextmenu:preventDefault="true"
         @oncontextmenu:stopPropagation="true"
         @ondragstart="() => OnDragStart(id)"
         @ondragover="e => OnRowDragOver(id, e)"
         @ondragover:preventDefault
         @ondragover:stopPropagation
         @ondrop="e => OnRowDrop(id, e)"
         @ondrop:preventDefault
         @ondrop:stopPropagation
         @ondragend="OnDragEnd">
        <button type="button"
                class="tree-twisty @(expanded ? "open" : null) @(childCount == 0 ? "leaf" : null)"
                disabled="@(childCount == 0)"
                title="@(expanded ? "Collapse" : "Expand")"
                tabindex="@(childCount == 0 ? -1 : 0)"
                @onclick:stopPropagation="true"
                @onclick="() => State.TogglePageExpanded(id)">
            <Icon Name="chevron_right" Class="tree-chevron" />
        </button>
        @* Always drawn, so a page with an icon sits at the same indent as one without. *@
        <PageIcon Icon="@(page.Icon)" Class="tree-icon" />
        @if (renaming)
        {
            <input id="tree-rename"
                   class="tree-rename"
                   value="@_renameDraft"
                   @onclick:stopPropagation="true"
                   @oninput="OnRenameInput"
                   @onkeydown="OnRenameKey"
                   @onblur="CommitRenameAsync" />
        }
        else
        {
            <span class="tree-label">@(page.DisplayTitle)</span>
        }
        <button type="button"
                class="tree-menu"
                title="Page actions"
                @onclick:stopPropagation="true"
                @onclick="e => OpenMenu(id, e)">
            <Icon Name="more_vert" />
        </button>
    </div>
}
</div>

@if (_menuPageId is not null || _emptyMenu)
{
    <ContextMenu Items="MenuItems()"
                 Left="_menuLeft"
                 Top="_menuTop"
                 OnClose="CloseMenu" />
}

@if (_movingId is not null)
{
    <Palette Items="MoveItems()"
             Placeholder="Move under…"
             InputId="tree-move-menu"
             EmptyText="No pages"
             Anchored="true"
             Left="_menuLeft"
             Top="_menuTop"
             OnClose="() => _movingId = null" />
}

@code {
    private string? _menuPageId;
    private bool _emptyMenu;
    private double _menuLeft;
    private double _menuTop;
    private string? _movingId;
    private string? _renamingId;
    private string _renameDraft = "";
    private bool _focusRename;
    private string? _dragId;
    private string? _hoverId;
    private string? _hoverEdge;
    private bool _dropRoot;

    [Parameter, EditorRequired]
    public required Workspace Workspace { get; set; }

    [Parameter]
    public string? ParentId { get; set; }

    [Parameter]
    public string? SelectedId { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    [Parameter]
    public EventCallback<string?> OnAddChild { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusRename)
            return;

        _focusRename = false;
        try
        {
            await Js.InvokeVoidAsync("syncly.focusElement", "tree-rename", true);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private IEnumerable<(PageRef Page, int Depth, int ChildCount)> VisibleRows()
    {
        return Walk(ParentId, 0);

        IEnumerable<(PageRef, int, int)> Walk(string? parent, int depth)
        {
            foreach (var page in Workspace.ChildrenOf(parent, State.CurrentSpaceId))
            {
                var childCount = Workspace.ChildrenOf(page.Id).Count;
                yield return (page, depth, childCount);

                if (childCount > 0 && State.IsPageExpanded(page.Id))
                {
                    foreach (var nested in Walk(page.Id, depth + 1))
                        yield return nested;
                }
            }
        }
    }

    private async Task AddChildAsync(string pageId)
    {
        State.ExpandPage(pageId);
        await OnAddChild.InvokeAsync(pageId);
    }

    private void OpenMenu(string pageId, MouseEventArgs e)
    {
        _movingId = null;
        _emptyMenu = false;
        _menuPageId = pageId;
        _menuLeft = e.ClientX;
        _menuTop = e.ClientY;
    }

    private void OnTreeContext(MouseEventArgs e)
    {
        // Row handlers stop this when a page was the target.
        _menuPageId = null;
        _movingId = null;
        _emptyMenu = true;
        _menuLeft = e.ClientX;
        _menuTop = e.ClientY;
    }

    private Task CloseMenu()
    {
        _menuPageId = null;
        _emptyMenu = false;
        return Task.CompletedTask;
    }

    private async Task OnRowKey(string pageId, KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            await OnSelect.InvokeAsync(pageId);
    }

    private IReadOnlyList<ContextMenu.MenuItem> MenuItems()
    {
        if (_emptyMenu)
        {
            return
            [
                new("New page", () => OnAddChild.InvokeAsync(null), "add"),
            ];
        }

        var pageId = _menuPageId;
        if (pageId is null)
            return [];

        return
        [
            new("New sub-page", () => AddChildAsync(pageId), "add"),
            new("Rename", () => StartRenameAsync(pageId), "edit"),
            new("Duplicate", () => DuplicateAsync(pageId), "content_copy"),
            new("Move to…", () => StartMoveAsync(pageId), "drive_file_move"),
            new("Delete", () => DeleteAsync(pageId), "delete", Danger: true),
        ];
    }

    private IReadOnlyList<Palette.PaletteItem> MoveItems()
    {
        var pageId = _movingId;
        if (pageId is null)
            return [];

        var blocked = DescendantsAndSelf(pageId).ToHashSet(StringComparer.Ordinal);
        var items = new List<Palette.PaletteItem>
        {
            new("home", "Top level", null, () => MoveAsync(pageId, null)),
        };

        items.AddRange(Workspace.PagesIn(State.CurrentSpaceId)
            .Where(p => !blocked.Contains(p.Id))
            .Select(p => new Palette.PaletteItem(
                p.Icon is { Length: > 0 } icon ? icon : "description",
                p.DisplayTitle,
                "Page",
                () => MoveAsync(pageId, p.Id))));

        return items;
    }

    private IEnumerable<string> DescendantsAndSelf(string pageId)
    {
        yield return pageId;
        foreach (var child in Workspace.ChildrenOf(pageId))
        {
            foreach (var nested in DescendantsAndSelf(child.Id))
                yield return nested;
        }
    }

    private Task StartRenameAsync(string pageId)
    {
        _menuPageId = null;
        var page = Workspace.Page(pageId);
        _renamingId = pageId;
        _renameDraft = page?.Title ?? "";
        _focusRename = true;
        return Task.CompletedTask;
    }

    private void OnRenameInput(ChangeEventArgs args) =>
        _renameDraft = args.Value?.ToString() ?? "";

    private async Task OnRenameKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await CommitRenameAsync();
            return;
        }

        if (args.Key == "Escape")
            _renamingId = null;
    }

    private async Task CommitRenameAsync()
    {
        var pageId = _renamingId;
        if (pageId is null)
            return;

        _renamingId = null;
        await Workspace.RenamePageAsync(pageId, _renameDraft.Trim());
    }

    private async Task DuplicateAsync(string pageId)
    {
        _menuPageId = null;
        var copyId = await Workspace.DuplicatePageAsync(pageId);
        var parent = Workspace.Page(copyId)?.ParentId;
        if (parent is not null)
            State.ExpandPage(parent);
        await OnSelect.InvokeAsync(copyId);
    }

    private Task StartMoveAsync(string pageId)
    {
        _menuPageId = null;
        _movingId = pageId;
        return Task.CompletedTask;
    }

    private async Task MoveAsync(string pageId, string? parentId)
    {
        _movingId = null;
        await Workspace.MovePageAsync(pageId, parentId);
        if (parentId is not null)
            State.ExpandPage(parentId);
    }

    private void OnDragStart(string pageId) => _dragId = pageId;

    private void OnDragEnd()
    {
        _dragId = null;
        _hoverId = null;
        _hoverEdge = null;
        _dropRoot = false;
    }

    private bool CanDropOn(string targetId) =>
        _dragId is { Length: > 0 } dragged
        && !DescendantsAndSelf(dragged).Contains(targetId, StringComparer.Ordinal);

    private string? RowDropClass(string id)
    {
        if (_hoverId != id)
            return null;

        return _hoverEdge switch
        {
            "before" => "drop-before",
            "after" => "drop-after",
            _ => "drop-into",
        };
    }

    private async Task OnRowDragOver(string targetId, DragEventArgs e)
    {
        _dropRoot = false;
        if (!CanDropOn(targetId))
        {
            _hoverId = null;
            _hoverEdge = null;
            return;
        }

        _hoverId = targetId;
        var edge = await DropHintAsync(targetId, e);
        if (_hoverEdge == edge)
            return;

        _hoverEdge = edge;
    }

    private async Task OnRowDrop(string targetId, DragEventArgs e)
    {
        var dragged = _dragId;
        var allowed = dragged is not null && CanDropOn(targetId);
        var edge = allowed ? await DropHintAsync(targetId, e) : null;
        OnDragEnd();
        if (dragged is null || !allowed || edge is null)
            return;

        if (edge == "into")
        {
            await MoveAsync(dragged, targetId);
            return;
        }

        var parentId = Workspace.Page(targetId)?.ParentId;
        await Workspace.MovePageAsync(dragged, parentId, targetId, after: edge == "after");
    }

    private async Task<string> DropHintAsync(string pageId, DragEventArgs e)
    {
        try
        {
            return await Js.InvokeAsync<string>("syncly.treeDropHint", pageId, e.ClientX, e.ClientY);
        }
        catch (JSDisconnectedException)
        {
            return "into";
        }
        catch (JSException)
        {
            return "into";
        }
    }

    private void OnRootDragOver()
    {
        if (_dragId is null)
            return;

        _hoverId = null;
        _hoverEdge = null;
        _dropRoot = true;
    }

    private async Task OnRootDrop()
    {
        var dragged = _dragId;
        OnDragEnd();
        if (dragged is null)
            return;

        await MoveAsync(dragged, null);
    }

    private async Task DeleteAsync(string pageId)
    {
        _menuPageId = null;
        var title = Workspace.Page(pageId)?.DisplayTitle ?? "this page";
        if (!await Js.InvokeAsync<bool>("syncly.confirm",
                $"Delete “{title}”? The page is removed on every device after the next sync."))
            return;

        var wasOpen = State.CurrentPageId == pageId;
        await Workspace.DeletePageAsync(pageId);

        if (!wasOpen)
            return;

        if (State.CanGoBack)
        {
            State.Back();
            return;
        }

        var next = Workspace.PagesIn(State.CurrentSpaceId).FirstOrDefault()?.Id;
        if (next is not null)
            State.Open(next);
    }
}
