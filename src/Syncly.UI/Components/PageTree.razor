@namespace Syncly.UI.Components
@inject EditorState State
@inject IJSRuntime Js

<div class="tree-drop @(_dropRoot ? "drop-hover" : null)"
     @ondragover="OnRootDragOver"
     @ondragover:preventDefault
     @ondrop="OnRootDrop">
@foreach (var (page, depth, childCount) in VisibleRows())
{
    var id = page.Id;
    var expanded = State.IsPageExpanded(id);
    var renaming = _renamingId == id;

    <div @key="id"
         class="tree-row @(id == SelectedId ? "selected" : null) @(_hoverId == id ? "drop-hover" : null)"
         style="padding-left: @(6 + depth * 14)px"
         draggable="@(renaming ? "false" : "true")"
         data-page="@id"
         @onclick="() => OnSelect.InvokeAsync(id)"
         @ondragstart="() => OnDragStart(id)"
         @ondragover="() => OnRowDragOver(id)"
         @ondragover:preventDefault
         @ondragover:stopPropagation
         @ondrop="() => OnRowDrop(id)"
         @ondrop:preventDefault
         @ondrop:stopPropagation
         @ondragend="OnDragEnd">
        <button type="button"
                class="tree-twisty @(expanded ? "open" : null)"
                disabled="@(childCount == 0)"
                title="@(expanded ? "Collapse" : "Expand")"
                @onclick:stopPropagation="true"
                @onclick="() => State.TogglePageExpanded(id)">
            @(childCount > 0 ? "▶" : "")
        </button>
        @if (!string.IsNullOrEmpty(page.Icon) && !renaming)
        {
            <span class="tree-icon" aria-hidden="true">@(page.Icon)</span>
        }
        @if (renaming)
        {
            <input id="tree-rename"
                   class="tree-rename"
                   value="@_renameDraft"
                   @onclick:stopPropagation="true"
                   @oninput="OnRenameInput"
                   @onkeydown="OnRenameKey"
                   @onblur="CommitRenameAsync" />
        }
        else
        {
            <span class="tree-label">@(page.DisplayTitle)</span>
        }
        <button type="button"
                class="tree-menu"
                title="Page actions"
                @onclick:stopPropagation="true"
                @onclick="() => OpenMenu(id)">⋮</button>
        <button type="button"
                class="tree-add"
                title="New sub-page"
                @onclick:stopPropagation="true"
                @onclick="() => AddChildAsync(id)">+</button>
    </div>
}
</div>

@if (_menuPageId is not null)
{
    <Palette Items="MenuItems()"
             Placeholder="Page actions"
             InputId="tree-page-menu"
             EmptyText="No actions"
             OnClose="CloseMenu" />
}

@if (_movingId is not null)
{
    <Palette Items="MoveItems()"
             Placeholder="Move under…"
             InputId="tree-move-menu"
             EmptyText="No pages"
             OnClose="() => _movingId = null" />
}

@code {
    private string? _menuPageId;
    private string? _movingId;
    private string? _renamingId;
    private string _renameDraft = "";
    private bool _focusRename;
    private string? _dragId;
    private string? _hoverId;
    private bool _dropRoot;

    [Parameter, EditorRequired]
    public required Workspace Workspace { get; set; }

    [Parameter]
    public string? ParentId { get; set; }

    [Parameter]
    public string? SelectedId { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    [Parameter]
    public EventCallback<string> OnAddChild { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusRename)
            return;

        _focusRename = false;
        try
        {
            await Js.InvokeVoidAsync("syncly.focusElement", "tree-rename", true);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private IEnumerable<(PageRef Page, int Depth, int ChildCount)> VisibleRows()
    {
        return Walk(ParentId, 0);

        IEnumerable<(PageRef, int, int)> Walk(string? parent, int depth)
        {
            foreach (var page in Workspace.ChildrenOf(parent, State.CurrentSpaceId))
            {
                var childCount = Workspace.ChildrenOf(page.Id).Count;
                yield return (page, depth, childCount);

                if (childCount > 0 && State.IsPageExpanded(page.Id))
                {
                    foreach (var nested in Walk(page.Id, depth + 1))
                        yield return nested;
                }
            }
        }
    }

    private async Task AddChildAsync(string pageId)
    {
        State.ExpandPage(pageId);
        await OnAddChild.InvokeAsync(pageId);
    }

    private void OpenMenu(string pageId)
    {
        _movingId = null;
        _menuPageId = pageId;
    }

    private Task CloseMenu()
    {
        _menuPageId = null;
        return Task.CompletedTask;
    }

    private IReadOnlyList<Palette.PaletteItem> MenuItems()
    {
        var pageId = _menuPageId;
        if (pageId is null)
            return [];

        return
        [
            new("✎", "Rename", null, () => StartRenameAsync(pageId)),
            new("↗", "Move to…", null, () => StartMoveAsync(pageId)),
            new("✕", "Delete", null, () => DeleteAsync(pageId)),
        ];
    }

    private IReadOnlyList<Palette.PaletteItem> MoveItems()
    {
        var pageId = _movingId;
        if (pageId is null)
            return [];

        var blocked = DescendantsAndSelf(pageId).ToHashSet(StringComparer.Ordinal);
        var items = new List<Palette.PaletteItem>
        {
            new("⌂", "Top level", null, () => MoveAsync(pageId, null)),
        };

        items.AddRange(Workspace.PagesIn(State.CurrentSpaceId)
            .Where(p => !blocked.Contains(p.Id))
            .Select(p => new Palette.PaletteItem(
                p.Icon is { Length: > 0 } icon ? icon : "◻",
                p.DisplayTitle,
                "Page",
                () => MoveAsync(pageId, p.Id))));

        return items;
    }

    private IEnumerable<string> DescendantsAndSelf(string pageId)
    {
        yield return pageId;
        foreach (var child in Workspace.ChildrenOf(pageId))
        {
            foreach (var nested in DescendantsAndSelf(child.Id))
                yield return nested;
        }
    }

    private Task StartRenameAsync(string pageId)
    {
        _menuPageId = null;
        var page = Workspace.Page(pageId);
        _renamingId = pageId;
        _renameDraft = page?.Title ?? "";
        _focusRename = true;
        return Task.CompletedTask;
    }

    private void OnRenameInput(ChangeEventArgs args) =>
        _renameDraft = args.Value?.ToString() ?? "";

    private async Task OnRenameKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await CommitRenameAsync();
            return;
        }

        if (args.Key == "Escape")
            _renamingId = null;
    }

    private async Task CommitRenameAsync()
    {
        var pageId = _renamingId;
        if (pageId is null)
            return;

        _renamingId = null;
        await Workspace.RenamePageAsync(pageId, _renameDraft.Trim());
    }

    private Task StartMoveAsync(string pageId)
    {
        _menuPageId = null;
        _movingId = pageId;
        return Task.CompletedTask;
    }

    private async Task MoveAsync(string pageId, string? parentId)
    {
        _movingId = null;
        await Workspace.MovePageAsync(pageId, parentId);
        if (parentId is not null)
            State.ExpandPage(parentId);
    }

    private void OnDragStart(string pageId) => _dragId = pageId;

    private void OnDragEnd()
    {
        _dragId = null;
        _hoverId = null;
        _dropRoot = false;
    }

    private bool CanDropOn(string targetId) =>
        _dragId is { Length: > 0 } dragged
        && !DescendantsAndSelf(dragged).Contains(targetId, StringComparer.Ordinal);

    private void OnRowDragOver(string targetId)
    {
        _dropRoot = false;
        _hoverId = CanDropOn(targetId) ? targetId : null;
    }

    private async Task OnRowDrop(string targetId)
    {
        var dragged = _dragId;
        var allowed = dragged is not null && CanDropOn(targetId);
        OnDragEnd();
        if (dragged is null || !allowed)
            return;

        await MoveAsync(dragged, targetId);
    }

    private void OnRootDragOver()
    {
        if (_dragId is null)
            return;

        _hoverId = null;
        _dropRoot = true;
    }

    private async Task OnRootDrop()
    {
        var dragged = _dragId;
        OnDragEnd();
        if (dragged is null)
            return;

        await MoveAsync(dragged, null);
    }

    private async Task DeleteAsync(string pageId)
    {
        _menuPageId = null;
        var title = Workspace.Page(pageId)?.DisplayTitle ?? "this page";
        if (!await Js.InvokeAsync<bool>("syncly.confirm",
                $"Delete “{title}”? The page is removed on every device after the next sync."))
            return;

        var wasOpen = State.CurrentPageId == pageId;
        await Workspace.DeletePageAsync(pageId);

        if (!wasOpen)
            return;

        if (State.CanGoBack)
        {
            State.Back();
            return;
        }

        var next = Workspace.PagesIn(State.CurrentSpaceId).FirstOrDefault()?.Id;
        if (next is not null)
            State.Open(next);
    }
}
