@namespace Syncly.UI.Components
@inject EditorState State

@foreach (var (page, depth, childCount) in VisibleRows())
{
    var id = page.Id;
    var expanded = State.IsPageExpanded(id);

    <div @key="id"
         class="tree-row @(id == SelectedId ? "selected" : null)"
         style="padding-left: @(6 + depth * 14)px"
         @onclick="() => OnSelect.InvokeAsync(id)">
        <button type="button"
                class="tree-twisty @(expanded ? "open" : null)"
                disabled="@(childCount == 0)"
                title="@(expanded ? "Collapse" : "Expand")"
                @onclick:stopPropagation="true"
                @onclick="() => State.TogglePageExpanded(id)">
            @(childCount > 0 ? "▶" : "")
        </button>
        @if (!string.IsNullOrEmpty(page.Icon))
        {
            <span class="tree-icon" aria-hidden="true">@(page.Icon)</span>
        }
        <span class="tree-label">@(page.DisplayTitle)</span>
        <button type="button"
                class="tree-add"
                title="New sub-page"
                @onclick:stopPropagation="true"
                @onclick="() => AddChildAsync(id)">+</button>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public required Workspace Workspace { get; set; }

    [Parameter]
    public string? ParentId { get; set; }

    [Parameter]
    public string? SelectedId { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    [Parameter]
    public EventCallback<string> OnAddChild { get; set; }

    private IEnumerable<(PageRef Page, int Depth, int ChildCount)> VisibleRows()
    {
        return Walk(ParentId, 0);

        IEnumerable<(PageRef, int, int)> Walk(string? parent, int depth)
        {
            foreach (var page in Workspace.ChildrenOf(parent, State.CurrentSpaceId))
            {
                var childCount = Workspace.ChildrenOf(page.Id).Count;
                yield return (page, depth, childCount);

                if (childCount > 0 && State.IsPageExpanded(page.Id))
                {
                    foreach (var nested in Walk(page.Id, depth + 1))
                        yield return nested;
                }
            }
        }
    }

    private async Task AddChildAsync(string pageId)
    {
        State.ExpandPage(pageId);
        await OnAddChild.InvokeAsync(pageId);
    }
}
