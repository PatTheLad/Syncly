@namespace Syncly.UI.Components
@inject IJSRuntime Js

<div class="overlay @(Anchored ? "anchored" : null)" @onclick="Close">
    <div class="palette @(Anchored ? "anchored" : null)"
         style="@AnchorStyle"
         @onclick:stopPropagation="true">
        <input id="@InputId"
               placeholder="@Placeholder"
               value="@_query"
               autocomplete="off"
               @oninput="OnQueryChanged"
               @onkeydown="OnKeyDown" />

        <div class="palette-list">
            @if (_matches.Count == 0)
            {
                <div class="palette-empty">@EmptyText</div>
            }
            else
            {
                @for (var i = 0; i < _matches.Count; i++)
                {
                    var index = i;
                    var item = _matches[i];
                    <button class="palette-item @(index == _active ? "active" : null)"
                            @onclick="() => RunAsync(item)">
                        <span class="glyph"><PageIcon Icon="@item.Glyph" Fallback="" /></span>
                        <span class="label">@item.Label</span>
                        @if (!string.IsNullOrEmpty(item.Hint))
                        {
                            <span class="hint">@item.Hint</span>
                        }
                    </button>
                }
            }
        </div>
    </div>
</div>

@code {
    private string _query = string.Empty;
    private int _active;
    private List<PaletteItem> _matches = [];

    /// <summary>One row: an icon, a label, an optional hint, and what to do when chosen.</summary>
    public sealed record PaletteItem(string Glyph, string Label, string? Hint, Func<Task> Run, bool Pin = false)
    {
        public string SearchText => $"{Label} {Hint}".ToLowerInvariant();
    }

    [Parameter, EditorRequired]
    public required IReadOnlyList<PaletteItem> Items { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Search";

    [Parameter]
    public string EmptyText { get; set; } = "No matches";

    [Parameter]
    public string InputId { get; set; } = "palette-input";

    /// <summary>Hangs the list off <see cref="Left"/>/<see cref="Top"/> instead of centring it.</summary>
    [Parameter]
    public bool Anchored { get; set; }

    [Parameter]
    public double Left { get; set; }

    [Parameter]
    public double Top { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string? AnchorStyle =>
        Anchored ? $"left:{Left.ToString("0")}px; top:{Top.ToString("0")}px" : null;

    /// <summary>Called on every keystroke, so the caller can search asynchronously.</summary>
    [Parameter]
    public EventCallback<string> OnQuery { get; set; }

    protected override void OnParametersSet() => Filter();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (Anchored)
            await Js.InvokeVoidAsync("syncly.clampFloating", ".palette.anchored");

        await Js.InvokeVoidAsync("syncly.focusElement", InputId, true);
    }

    private async Task OnQueryChanged(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        _active = 0;
        Filter();

        if (OnQuery.HasDelegate)
            await OnQuery.InvokeAsync(_query);
    }

    private void Filter()
    {
        var terms = _query.Trim().ToLowerInvariant();
        _matches = terms.Length == 0
            ? Items.Where(i => !i.Pin).ToList()
            : Items.Where(i => i.Pin || i.SearchText.Contains(terms, StringComparison.Ordinal)).ToList();

        _active = Math.Clamp(_active, 0, Math.Max(_matches.Count - 1, 0));
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "ArrowDown":
                _active = _matches.Count == 0 ? 0 : (_active + 1) % _matches.Count;
                break;

            case "ArrowUp":
                _active = _matches.Count == 0 ? 0 : (_active - 1 + _matches.Count) % _matches.Count;
                break;

            case "Enter" when _active < _matches.Count:
                await RunAsync(_matches[_active]);
                break;

            case "Escape":
                await Close();
                break;
        }
    }

    private async Task RunAsync(PaletteItem item)
    {
        await Close();
        await item.Run();
    }

    private Task Close() => OnClose.InvokeAsync();
}
