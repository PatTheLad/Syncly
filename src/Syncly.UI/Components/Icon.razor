@namespace Syncly.UI.Components
@inject NavigationManager Navigation

@* One vendored Material Symbol, tinted with the surrounding text colour. *@
<span class="mi @Class" style="@Style" aria-hidden="true"></span>

@code {
    [Parameter, EditorRequired]
    public required string Name { get; set; }

    [Parameter]
    public string? Class { get; set; }

    // Root-relative from BaseUri so masks still load on /page/{id}, not only on /.
    private string Style => $"--mi: url('{Navigation.BaseUri}icons/material/{Name}.svg')";
}
