@page "/graph"
@namespace Syncly.UI.Pages
@implements IAsyncDisposable
@inject EditorState State
@inject NavigationManager Nav
@inject IJSRuntime Js
@using System.Globalization

<div class="galaxy-page">
    <canvas id="@CanvasId"
            class="galaxy-canvas"
            tabindex="0"
            role="application"
            aria-label="Page galaxy. Drag to pan, scroll to zoom, double-click a star to fly in."></canvas>

    <header class="galaxy-hud">
        <div class="galaxy-hud-copy">
            <h1 class="galaxy-title">Galaxy</h1>
            <p class="galaxy-sub">
                @(State.CurrentSpace?.DisplayTitle ?? "This space")
                <span class="galaxy-dot">·</span>
                @Plural(_graph.Nodes.Count(n => !n.Missing), "world")
                @if (_graph.Edges.Count > 0)
                {
                    <span class="galaxy-dot">·</span>
                    @Plural(_graph.Edges.Count, "link")
                }
            </p>
        </div>

        <div class="galaxy-tools">
            <label class="galaxy-search @(_query.Length > 0 ? "active" : null)">
                <span class="galaxy-search-icon" aria-hidden="true">⌕</span>
                <input placeholder="Find a world"
                       value="@_query"
                       aria-label="Find a page in the galaxy"
                       @oninput="OnQueryInput"
                       @onkeydown="OnQueryKeyDown" />
                @if (_query.Length > 0)
                {
                    <span class="galaxy-search-hits">@(_hitCount == 0 ? "none" : _hitCount.ToString(CultureInfo.InvariantCulture))</span>
                    <button type="button" class="galaxy-search-clear" title="Clear" @onclick="ClearQueryAsync">×</button>
                }
            </label>

            <button type="button" class="galaxy-btn" title="Fit everything (Home)" @onclick="FitAsync">⤢</button>
            <button type="button"
                    class="galaxy-btn"
                    title="@(State.CurrentPageId is null ? "No page open" : "Fly to the open page")"
                    disabled="@(State.CurrentPageId is null || !_nodeIds.Contains(State.CurrentPageId))"
                    @onclick="LocateAsync">◎</button>
            <button type="button"
                    class="galaxy-btn @(_motion ? "on" : null)"
                    title="@(_motion ? "Pause motion" : "Resume motion")"
                    aria-pressed="@(_motion ? "true" : "false")"
                    @onclick="ToggleMotionAsync">@(_motion ? "❚❚" : "▶")</button>
        </div>
    </header>

    @if (_legend.Count > 0)
    {
        <nav class="galaxy-legend" aria-label="Body types">
            @foreach (var entry in _legend)
            {
                var hidden = _hidden.Contains(entry.Body);
                <button type="button"
                        class="galaxy-chip kind-@entry.Key @(hidden ? "off" : null)"
                        title="@(hidden ? "Show" : "Hide") @entry.Label.ToLowerInvariant()"
                        aria-pressed="@(hidden ? "false" : "true")"
                        @onclick="() => ToggleKindAsync(entry.Body)">
                    <span class="galaxy-chip-dot" aria-hidden="true"></span>
                    <span class="galaxy-chip-label">@entry.Label</span>
                    <span class="galaxy-chip-count">@entry.Count</span>
                </button>
            }
        </nav>
    }

    <div class="galaxy-hint" aria-hidden="true">Drag to pan · Scroll to zoom · Double-click a star to fly in · Home to fit</div>

    @if (_loaded && _graph.Nodes.Count == 0)
    {
        <div class="galaxy-empty">
            <div class="galaxy-empty-orbit" aria-hidden="true"><span></span></div>
            <h2>Quiet space</h2>
            <p>Create a page, then nest another beneath it to light your first star.</p>
        </div>
    }

    @if (_preview is { } preview)
    {
        <article class="galaxy-preview @(_previewVisible ? "show" : null)"
                 style="@PreviewStyle"
                 @onmouseenter="HoldPreview"
                 @onmouseleave="ReleasePreview"
                 @onclick="() => OpenIdAsync(preview.Id)">
            <header class="galaxy-preview-head">
                <span class="galaxy-preview-icon kind-@preview.Body.ToString().ToLowerInvariant()">@(preview.Icon is { Length: > 0 } icon ? icon : Initial(preview.Title))</span>
                <div class="galaxy-preview-copy">
                    <h3>@preview.Title</h3>
                    <div class="galaxy-preview-path">
                        @if (preview.Path.Count == 0)
                        {
                            <span>@State.CurrentSpace?.DisplayTitle</span>
                        }
                        else
                        {
                            @for (var i = 0; i < preview.Path.Count; i++)
                            {
                                if (i > 0)
                                {
                                    <span class="galaxy-preview-sep">›</span>
                                }
                                <span>@preview.Path[i]</span>
                            }
                        }
                    </div>
                </div>
                <span class="galaxy-preview-kind">@KindLabel(preview.Body)</span>
            </header>

            @if (preview.Lines.Count > 0)
            {
                <div class="galaxy-preview-body">
                    @foreach (var line in preview.Lines)
                    {
                        <p>@line</p>
                    }
                </div>
            }
            else
            {
                <div class="galaxy-preview-body empty">Nothing written here yet.</div>
            }

            <footer class="galaxy-preview-foot">
                <span>@Plural(preview.ChildCount, "subpage")</span>
                <span class="galaxy-dot">·</span>
                <span>@Plural(preview.LinkCount, "link")</span>
                <span class="galaxy-dot">·</span>
                <span>@Relative(preview.UpdatedAt)</span>
                <span class="galaxy-preview-cta">Open ↵</span>
            </footer>
        </article>
    }
    else if (_missingPreview is { } missing)
    {
        <article class="galaxy-preview missing @(_previewVisible ? "show" : null)"
                 style="@PreviewStyle"
                 @onmouseenter="HoldPreview"
                 @onmouseleave="ReleasePreview"
                 @onclick="() => OpenIdAsync(missing.Id)">
            <header class="galaxy-preview-head">
                <span class="galaxy-preview-icon kind-dust">?</span>
                <div class="galaxy-preview-copy">
                    <h3>@missing.Title</h3>
                    <div class="galaxy-preview-path">Unresolved link</div>
                </div>
            </header>
            <div class="galaxy-preview-body empty">Something links here, but the page does not exist yet.</div>
            <footer class="galaxy-preview-foot"><span class="galaxy-preview-cta">Create page ↵</span></footer>
        </article>
    }
</div>

@code {
    private const string CanvasId = "galaxy-canvas";

    private sealed record LegendEntry(GraphBodyKind Body, string Key, string Label, int Count);

    private PageGraph _graph = new([], [], []);
    private HashSet<string> _nodeIds = new(StringComparer.Ordinal);
    private List<LegendEntry> _legend = [];
    private readonly HashSet<GraphBodyKind> _hidden = [];

    private DotNetObjectReference<Graph>? _self;
    private bool _mounted;
    private bool _loaded;
    private bool _disposed;
    private bool _motion = true;
    private long _loadGeneration;

    private string _query = string.Empty;
    private int _hitCount;
    private CancellationTokenSource? _searchCts;

    private GraphPreview? _preview;
    private GraphNode? _missingPreview;
    private bool _previewVisible;
    private bool _previewHeld;
    private double _previewX;
    private double _previewY;
    private string? _hoverId;
    private CancellationTokenSource? _hideCts;
    private CancellationTokenSource? _previewCts;

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        State.Workspace.Changed += OnWorkspaceChanged;
    }

    protected override Task OnInitializedAsync() =>
        LoadAsync(Interlocked.Increment(ref _loadGeneration));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        _self = DotNetObjectReference.Create(this);
        try
        {
            _mounted = await Js.InvokeAsync<bool>("synclyGalaxy.mount", CanvasId, _self, new { reducedMotion = false });
            if (_mounted)
            {
                _motion = await Js.InvokeAsync<bool>("synclyGalaxy.isMotion", CanvasId);
                if (_loaded)
                    await PushDataAsync();
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            _mounted = false;
        }
    }

    private void OnWorkspaceChanged()
    {
        if (_disposed)
            return;
        var generation = Interlocked.Increment(ref _loadGeneration);
        _ = InvokeAsync(() => LoadAsync(generation));
    }

    private void OnStateChanged()
    {
        if (_disposed)
            return;
        _ = InvokeAsync(async () =>
        {
            await SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.setCurrent", CanvasId, State.CurrentPageId).AsTask());
            StateHasChanged();
        });
    }

    private async Task LoadAsync(long generation)
    {
        var graph = await State.Workspace.GraphAsync();
        if (_disposed || generation != Interlocked.Read(ref _loadGeneration))
            return;

        _graph = graph;
        _nodeIds = graph.Nodes.Select(n => n.Id).ToHashSet(StringComparer.Ordinal);
        _legend = BuildLegend(graph);
        _loaded = true;

        if (_mounted)
            await PushDataAsync();

        StateHasChanged();
    }

    private static List<LegendEntry> BuildLegend(PageGraph graph) =>
        graph.Nodes
            .GroupBy(n => n.Body)
            .OrderBy(g => (int)g.Key)
            .Select(g => new LegendEntry(g.Key, g.Key.ToString().ToLowerInvariant(), KindLabel(g.Key, plural: true), g.Count()))
            .ToList();

    private Task PushDataAsync()
    {
        var payload = new
        {
            spaceKey = State.CurrentSpaceId,
            currentId = State.CurrentPageId,
            nodes = _graph.Nodes.Select(n => new
            {
                id = n.Id,
                title = n.Title,
                icon = n.Icon,
                x = n.X,
                y = n.Y,
                size = n.Size,
                depth = n.Depth,
                parentId = n.ParentId,
                body = n.Body.ToString().ToLowerInvariant(),
                missing = n.Missing,
            }),
            edges = _graph.Edges.Select(e => new { from = e.From, to = e.To }),
        };

        return SafeJsAsync(async () =>
        {
            await Js.InvokeVoidAsync("synclyGalaxy.setData", CanvasId, payload);
            if (_hidden.Count > 0)
                await Js.InvokeVoidAsync("synclyGalaxy.setFilter", CanvasId, _hidden.Select(h => h.ToString().ToLowerInvariant()));
            if (_query.Length > 0)
                _hitCount = await Js.InvokeAsync<int>("synclyGalaxy.search", CanvasId, _query);
        });
    }

    // ------------------------------------------------------------- HUD

    private Task FitAsync() => SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.fit", CanvasId, false).AsTask());

    private Task LocateAsync() => SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.locate", CanvasId).AsTask());

    private async Task ToggleMotionAsync()
    {
        _motion = !_motion;
        await SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.setMotion", CanvasId, _motion).AsTask());
    }

    private async Task ToggleKindAsync(GraphBodyKind body)
    {
        if (!_hidden.Remove(body))
            _hidden.Add(body);
        await SafeJsAsync(() => Js.InvokeVoidAsync(
            "synclyGalaxy.setFilter",
            CanvasId,
            _hidden.Select(h => h.ToString().ToLowerInvariant())).AsTask());
    }

    private void OnQueryInput(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        _ = DebouncedSearchAsync(cts.Token);
    }

    private async Task DebouncedSearchAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(140, ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (_disposed)
            return;

        await SafeJsAsync(async () =>
        {
            _hitCount = await Js.InvokeAsync<int>("synclyGalaxy.search", CanvasId, _query);
        });
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnQueryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            await ClearQueryAsync();
    }

    private async Task ClearQueryAsync()
    {
        _query = string.Empty;
        _hitCount = 0;
        _searchCts?.Cancel();
        await SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.search", CanvasId, string.Empty).AsTask());
    }

    // ------------------------------------------------------------- hover preview

    [JSInvokable]
    public async Task OnHover(string? id, double clientX, double clientY)
    {
        if (_disposed)
            return;

        if (id is null)
        {
            _hoverId = null;
            ScheduleHide();
            return;
        }

        _hideCts?.Cancel();
        _hoverId = id;
        _previewX = clientX;
        _previewY = clientY;

        var node = _graph.Nodes.FirstOrDefault(n => n.Id == id);
        if (node is null)
            return;

        if (node.Missing)
        {
            _preview = null;
            _missingPreview = node;
            _previewVisible = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _previewCts?.Cancel();
        var cts = _previewCts = new CancellationTokenSource();
        GraphPreview? preview;
        try
        {
            preview = await State.Workspace.PreviewAsync(id, 4, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested || _disposed || _hoverId != id)
            return;

        _missingPreview = null;
        _preview = preview;
        _previewVisible = preview is not null;
        await InvokeAsync(StateHasChanged);
    }

    private void ScheduleHide()
    {
        _hideCts?.Cancel();
        var cts = _hideCts = new CancellationTokenSource();
        _ = HideAfterAsync(cts.Token);
    }

    private async Task HideAfterAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(180, ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (_disposed || _previewHeld || _hoverId is not null)
            return;

        _previewVisible = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(180, ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (_disposed || _previewVisible)
            return;

        _preview = null;
        _missingPreview = null;
        await InvokeAsync(StateHasChanged);
    }

    private void HoldPreview()
    {
        _previewHeld = true;
        _hideCts?.Cancel();
    }

    private void ReleasePreview()
    {
        _previewHeld = false;
        if (_hoverId is null)
            ScheduleHide();
    }

    private string PreviewStyle =>
        $"--px:{F(_previewX)}px;--py:{F(_previewY)}px";

    // ------------------------------------------------------------- open

    [JSInvokable]
    public Task OnOpen(string id) => InvokeAsync(() => OpenIdAsync(id));

    private async Task OpenIdAsync(string id)
    {
        var node = _graph.Nodes.FirstOrDefault(n => n.Id == id);
        if (node is null)
            return;

        if (node.Missing)
        {
            var pageId = await State.Workspace.EnsurePageByTitleAsync(node.Title);
            State.Open(pageId);
        }
        else
        {
            State.Open(node.Id);
        }

        Nav.NavigateTo("");
    }

    // ------------------------------------------------------------- helpers

    private static string KindLabel(GraphBodyKind body, bool plural = false) => body switch
    {
        GraphBodyKind.Star => plural ? "Stars" : "Star",
        GraphBodyKind.Planet => plural ? "Planets" : "Planet",
        GraphBodyKind.Moon => plural ? "Moons" : "Moon",
        GraphBodyKind.Asteroid => plural ? "Asteroids" : "Asteroid",
        GraphBodyKind.Meteor => plural ? "Meteors" : "Meteor",
        _ => plural ? "Unresolved" : "Unresolved",
    };

    private static string Plural(int count, string noun) =>
        $"{count.ToString(CultureInfo.InvariantCulture)} {noun}{(count == 1 ? string.Empty : "s")}";

    private static string Initial(string title)
    {
        var t = title.Trim();
        return t.Length == 0 ? "?" : char.ToUpperInvariant(t[0]).ToString();
    }

    private static string Relative(DateTimeOffset when)
    {
        if (when == default)
            return "never edited";

        var span = DateTimeOffset.Now - when;
        if (span < TimeSpan.FromMinutes(1))
            return "edited just now";
        if (span < TimeSpan.FromHours(1))
            return $"edited {(int)span.TotalMinutes} min ago";
        if (span < TimeSpan.FromDays(1))
            return $"edited {(int)span.TotalHours} h ago";
        if (span < TimeSpan.FromDays(2))
            return "edited yesterday";
        if (span < TimeSpan.FromDays(30))
            return $"edited {(int)span.TotalDays} d ago";
        return "edited " + when.ToLocalTime().ToString("d MMM yyyy", CultureInfo.InvariantCulture);
    }

    private static string F(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private async Task SafeJsAsync(Func<Task> call)
    {
        if (_disposed || !_mounted)
            return;
        try
        {
            await call();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Interlocked.Increment(ref _loadGeneration);
        State.Changed -= OnStateChanged;
        State.Workspace.Changed -= OnWorkspaceChanged;
        _searchCts?.Cancel();
        _hideCts?.Cancel();
        _previewCts?.Cancel();

        if (_mounted)
        {
            try
            {
                await Js.InvokeVoidAsync("synclyGalaxy.destroy", CanvasId);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        _self?.Dispose();
    }
}
