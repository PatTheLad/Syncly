@page "/graph"
@namespace Syncly.UI.Pages
@implements IAsyncDisposable
@inject EditorState State
@inject NavigationManager Nav
@inject IJSRuntime Js
@using System.Globalization

<div class="galaxy-page">
    <canvas id="@CanvasId"
            class="galaxy-canvas"
            tabindex="0"
            role="application"
            aria-label="Page galaxy. Drag to pan, scroll to zoom, click to select, Enter to open, double-click to fly in."></canvas>

    <header class="galaxy-hud">
        <div class="galaxy-hud-copy">
            <h1 class="galaxy-title">Galaxy</h1>
            <p class="galaxy-sub">
                @(State.CurrentSpace?.DisplayTitle ?? "This space")
                <span class="galaxy-dot">·</span>
                @Plural(_graph.Nodes.Count(n => !n.Missing), "world")
                @if (_graph.Edges.Count > 0)
                {
                    <span class="galaxy-dot">·</span>
                    @Plural(_graph.Edges.Count, "link")
                }
            </p>
            @if (_trail.Count > 0)
            {
                <nav class="galaxy-trail" aria-label="Where you are">
                    <button type="button" class="galaxy-trail-chip" @onclick="FitAsync">@(State.CurrentSpace?.DisplayTitle ?? "Space")</button>
                    @foreach (var crumb in _trail)
                    {
                        <span class="galaxy-trail-sep">›</span>
                        <button type="button"
                                class="galaxy-trail-chip kind-@crumb.Body.ToString().ToLowerInvariant()"
                                @onclick="() => FlyToAsync(crumb.Id)">@Label(crumb)</button>
                    }
                </nav>
            }
        </div>

        <div class="galaxy-tools">
            <label class="galaxy-search @(_query.Length > 0 ? "active" : null)">
                <span class="galaxy-search-icon" aria-hidden="true">⌕</span>
                <input id="@SearchId"
                       placeholder="Find a world"
                       value="@_query"
                       aria-label="Find a page in the galaxy"
                       @oninput="OnQueryInput"
                       @onkeydown="OnQueryKeyDown" />
                @if (_query.Length > 0)
                {
                    <span class="galaxy-search-hits">@(_hitCount == 0 ? "none" : _hitCount.ToString(CultureInfo.InvariantCulture))</span>
                    <button type="button" class="galaxy-search-clear" title="Clear" @onclick="ClearQueryAsync">×</button>
                }
            </label>

            <div class="galaxy-lens" role="radiogroup" aria-label="Lens">
                @foreach (var lens in Lenses)
                {
                    <button type="button"
                            class="galaxy-lens-btn @(_lens == lens.Key ? "on" : null)"
                            role="radio"
                            aria-checked="@(_lens == lens.Key ? "true" : "false")"
                            title="@lens.Hint"
                            @onclick="() => SetLensAsync(lens.Key)">@lens.Label</button>
                }
            </div>

            <button type="button" class="galaxy-btn" title="Fit everything (Home)" @onclick="FitAsync">⤢</button>
            <button type="button"
                    class="galaxy-btn"
                    title="@(State.CurrentPageId is null ? "No page open" : "Fly to the open page")"
                    disabled="@(State.CurrentPageId is null || !_nodeIds.Contains(State.CurrentPageId))"
                    @onclick="LocateAsync">◎</button>
            <button type="button"
                    class="galaxy-btn @(_opt.Motion ? "on" : null)"
                    title="@(_opt.Motion ? "Pause motion" : "Resume motion")"
                    aria-pressed="@(_opt.Motion ? "true" : "false")"
                    @onclick="ToggleMotionAsync">@(_opt.Motion ? "❚❚" : "▶")</button>
            <div class="galaxy-pop-anchor">
                <button type="button"
                        class="galaxy-btn @(_settingsOpen ? "on" : null)"
                        title="Galaxy settings"
                        aria-expanded="@(_settingsOpen ? "true" : "false")"
                        @onclick="() => _settingsOpen = !_settingsOpen">⚙</button>
                @if (_settingsOpen)
                {
                    <div class="galaxy-pop" role="dialog" aria-label="Galaxy settings">
                        <div class="galaxy-pop-row">
                            <span>Motion</span>
                            <button type="button" class="galaxy-switch @(_opt.Motion ? "on" : null)" role="switch" aria-checked="@(_opt.Motion ? "true" : "false")" @onclick="ToggleMotionAsync"><span></span></button>
                        </div>
                        <div class="galaxy-pop-row">
                            <span>Effects <small>bloom, particles, belts</small></span>
                            <button type="button" class="galaxy-switch @(_opt.Effects ? "on" : null)" role="switch" aria-checked="@(_opt.Effects ? "true" : "false")" @onclick="() => SetOptionAsync(o => o with { Effects = !o.Effects })"><span></span></button>
                        </div>
                        <div class="galaxy-pop-row">
                            <span>Hover sound</span>
                            <button type="button" class="galaxy-switch @(_opt.Sound ? "on" : null)" role="switch" aria-checked="@(_opt.Sound ? "true" : "false")" @onclick="() => SetOptionAsync(o => o with { Sound = !o.Sound })"><span></span></button>
                        </div>
                        <div class="galaxy-pop-row">
                            <span>Labels</span>
                            <div class="galaxy-seg">
                                <button type="button" class="@(_opt.Labels == "auto" ? "on" : null)" @onclick="() => SetLabelsAsync(LabelsAuto)">Auto</button>
                                <button type="button" class="@(_opt.Labels == "all" ? "on" : null)" @onclick="() => SetLabelsAsync(LabelsAll)">All</button>
                                <button type="button" class="@(_opt.Labels == "min" ? "on" : null)" @onclick="() => SetLabelsAsync(LabelsMin)">Minimal</button>
                            </div>
                        </div>
                        <div class="galaxy-pop-row">
                            <span>Starfield</span>
                            <div class="galaxy-seg">
                                <button type="button" class="@(_opt.Density < 0.75 ? "on" : null)" @onclick="() => SetOptionAsync(o => o with { Density = 0.5 })">Sparse</button>
                                <button type="button" class="@(_opt.Density is >= 0.75 and < 1.25 ? "on" : null)" @onclick="() => SetOptionAsync(o => o with { Density = 1 })">Normal</button>
                                <button type="button" class="@(_opt.Density >= 1.25 ? "on" : null)" @onclick="() => SetOptionAsync(o => o with { Density = 1.5 })">Dense</button>
                            </div>
                        </div>
                        <div class="galaxy-pop-keys">
                            <span><kbd>Click</kbd> select</span>
                            <span><kbd>Enter</kbd> open</span>
                            <span><kbd>F</kbd> fly</span>
                            <span><kbd>Tab</kbd> siblings</span>
                            <span><kbd>↑↓←→</kbd> neighbours</span>
                            <span><kbd>/</kbd> search</span>
                            <span><kbd>Home</kbd> fit</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </header>

    @if (_legend.Count > 0)
    {
        <div class="galaxy-bottom">
            <nav class="galaxy-legend" aria-label="Body types">
                @foreach (var entry in _legend)
                {
                    var hidden = _hidden.Contains(entry.Body);
                    <button type="button"
                            class="galaxy-chip kind-@entry.Key @(hidden ? "off" : null)"
                            title="@(hidden ? "Show" : "Hide") @entry.Label.ToLowerInvariant()"
                            aria-pressed="@(hidden ? "false" : "true")"
                            @onclick="() => ToggleKindAsync(entry.Body)">
                        <span class="galaxy-chip-dot" aria-hidden="true"></span>
                        <span class="galaxy-chip-label">@entry.Label</span>
                        <span class="galaxy-chip-count">@entry.Count</span>
                    </button>
                }
                @if (_timeMax > _timeMin)
                {
                    <button type="button"
                            class="galaxy-chip time @(_timelapse ? "on" : null)"
                            title="@(_timelapse ? "Close time-lapse" : "Watch pages appear over time")"
                            aria-pressed="@(_timelapse ? "true" : "false")"
                            @onclick="ToggleTimelapseAsync">
                        <span class="galaxy-chip-dot" aria-hidden="true"></span>
                        <span class="galaxy-chip-label">Time-lapse</span>
                    </button>
                }
            </nav>

            @if (_timelapse)
            {
                <div class="galaxy-time" role="group" aria-label="Time-lapse">
                    <button type="button" class="galaxy-btn small" title="@(_playing ? "Pause" : "Play")" @onclick="TogglePlayAsync">@(_playing ? "❚❚" : "▶")</button>
                    <input type="range"
                           min="0"
                           max="1000"
                           value="@_timeValue"
                           aria-label="Point in time"
                           @oninput="OnTimeInput" />
                    <span class="galaxy-time-label">@TimeLabel()</span>
                    <span class="galaxy-time-count">@Plural(BornCount(), "world")</span>
                </div>
            }
        </div>
    }

    <div class="galaxy-hint" aria-hidden="true">Drag to pan · Scroll to zoom · Click to select · Enter to open · Right-click for more</div>

    @if (_loaded && _graph.Nodes.Count == 0)
    {
        <div class="galaxy-empty">
            <div class="galaxy-empty-orbit" aria-hidden="true"><span></span></div>
            <h2>Quiet space</h2>
            <p>Create a page, then nest another beneath it to light your first star.</p>
        </div>
    }

    @if (_preview is { } preview)
    {
        <article class="galaxy-preview @(_previewVisible ? "show" : null) @(_pinned && preview.Id == _selectedId ? "pinned" : null) @(_cardX is null ? "docked" : null)"
                 style="@PreviewStyle"
                 @onmouseenter="HoldPreview"
                 @onmouseleave="ReleasePreview"
                 @onclick="() => OpenIdAsync(preview.Id)">
            <header class="galaxy-preview-head">
                <span class="galaxy-preview-icon kind-@preview.Body.ToString().ToLowerInvariant()">@(preview.Icon is { Length: > 0 } icon ? icon : Initial(preview.Title))</span>
                <div class="galaxy-preview-copy">
                    <h3>@preview.Title</h3>
                    <div class="galaxy-preview-path">
                        @if (preview.Path.Count == 0)
                        {
                            <span>@State.CurrentSpace?.DisplayTitle</span>
                        }
                        else
                        {
                            @for (var i = 0; i < preview.Path.Count; i++)
                            {
                                if (i > 0)
                                {
                                    <span class="galaxy-preview-sep">›</span>
                                }
                                <span>@preview.Path[i]</span>
                            }
                        }
                    </div>
                </div>
                <span class="galaxy-preview-kind">@KindLabel(preview.Body)</span>
            </header>

            @if (preview.Lines.Count > 0)
            {
                <div class="galaxy-preview-body">
                    @foreach (var line in preview.Lines)
                    {
                        <p>@line</p>
                    }
                </div>
            }
            else
            {
                <div class="galaxy-preview-body empty">Nothing written here yet.</div>
            }

            <footer class="galaxy-preview-foot">
                <span>@Plural(preview.ChildCount, "subpage")</span>
                <span class="galaxy-dot">·</span>
                <span>@Plural(preview.LinkCount, "link")</span>
                <span class="galaxy-dot">·</span>
                <span>@Relative(preview.UpdatedAt)</span>
                @if (_pinned && preview.Id == _selectedId)
                {
                    <button type="button" class="galaxy-preview-open" @onclick="() => OpenIdAsync(preview.Id)" @onclick:stopPropagation="true">Open <kbd>↵</kbd></button>
                }
                else
                {
                    <span class="galaxy-preview-cta">Click to select</span>
                }
            </footer>
        </article>
    }
    else if (_missingPreview is { } missing)
    {
        <article class="galaxy-preview missing @(_previewVisible ? "show" : null) @(_pinned && missing.Id == _selectedId ? "pinned" : null) @(_cardX is null ? "docked" : null)"
                 style="@PreviewStyle"
                 @onmouseenter="HoldPreview"
                 @onmouseleave="ReleasePreview"
                 @onclick="() => OpenIdAsync(missing.Id)">
            <header class="galaxy-preview-head">
                <span class="galaxy-preview-icon kind-dust">?</span>
                <div class="galaxy-preview-copy">
                    <h3>@missing.Title</h3>
                    <div class="galaxy-preview-path">Unresolved link</div>
                </div>
            </header>
            <div class="galaxy-preview-body empty">Something links here, but the page does not exist yet.</div>
            <footer class="galaxy-preview-foot"><span class="galaxy-preview-cta">Create page ↵</span></footer>
        </article>
    }

    @if (_menu is { } menu)
    {
        <div class="galaxy-menu-backdrop" @onclick="CloseMenu" @oncontextmenu="CloseMenu" @oncontextmenu:preventDefault="true"></div>
        <div class="galaxy-menu" role="menu" style="@MenuStyle" @onkeydown="OnMenuKeyDown">
            @if (menu.Node is { } node)
            {
                <div class="galaxy-menu-head">
                    <span class="galaxy-menu-icon kind-@node.Body.ToString().ToLowerInvariant()">@(node.Icon is { Length: > 0 } micon ? micon : Initial(node.Title))</span>
                    <span class="galaxy-menu-title">@node.Title</span>
                </div>
                @if (_renaming)
                {
                    <input class="galaxy-menu-rename"
                           id="@RenameId"
                           value="@_renameText"
                           aria-label="New title"
                           @oninput="e => _renameText = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="OnRenameKeyDown"
                           @onclick:stopPropagation="true" />
                    <div class="galaxy-menu-actions">
                        <button type="button" class="galaxy-menu-item" @onclick="CommitRenameAsync">Save</button>
                        <button type="button" class="galaxy-menu-item muted" @onclick="() => _renaming = false">Cancel</button>
                    </div>
                }
                else if (node.Missing)
                {
                    <button type="button" role="menuitem" class="galaxy-menu-item" @onclick="() => OpenIdAsync(node.Id)">Create page</button>
                    <button type="button" role="menuitem" class="galaxy-menu-item" @onclick="() => CopyLinkAsync(node.Title)">Copy [[link]]</button>
                }
                else
                {
                    <button type="button" role="menuitem" class="galaxy-menu-item" @onclick="() => OpenIdAsync(node.Id)">Open <kbd>↵</kbd></button>
                    <button type="button" role="menuitem" class="galaxy-menu-item" @onclick="() => MenuFlyAsync(node.Id)">Fly to <kbd>F</kbd></button>
                    <button type="button" role="menuitem" class="galaxy-menu-item" @onclick="() => NewSubpageAsync(node.Id)">New subpage</button>
                    <div class="galaxy-menu-sep"></div>
                    <button type="button" role="menuitem" class="galaxy-menu-item" @onclick="() => StartRenameAsync(node)">Rename</button>
                    <button type="button" role="menuitem" class="galaxy-menu-item" @onclick="() => DuplicateAsync(node.Id)">Duplicate</button>
                    <button type="button" role="menuitem" class="galaxy-menu-item" @onclick="() => CopyLinkAsync(node.Title)">Copy [[link]]</button>
                    <div class="galaxy-menu-sep"></div>
                    <button type="button" role="menuitem" class="galaxy-menu-item danger" @onclick="() => DeleteAsync(node.Id)">@(_confirmDelete ? "Really delete?" : "Delete")</button>
                }
            }
            else
            {
                <button type="button" role="menuitem" class="galaxy-menu-item" @onclick="() => NewSubpageAsync(null)">New page</button>
                <button type="button" role="menuitem" class="galaxy-menu-item" @onclick="MenuFitAsync">Fit everything <kbd>Home</kbd></button>
                <button type="button" role="menuitem" class="galaxy-menu-item" @onclick="MenuToggleMotionAsync">@(_opt.Motion ? "Pause motion" : "Resume motion")</button>
            }
        </div>
    }
</div>

@code {
    private const string CanvasId = "galaxy-canvas";
    private const string SearchId = "galaxy-search-input";
    private const string RenameId = "galaxy-rename-input";
    private const int TimelapseSeconds = 8;

    private sealed record LegendEntry(GraphBodyKind Body, string Key, string Label, int Count);
    private sealed record LensEntry(string Key, string Label, string Hint);
    private sealed record Options(bool Motion, string Labels, double Density, bool Sound, bool Effects);
    private sealed record MenuState(GraphNode? Node, double X, double Y);

    private static readonly LensEntry[] Lenses =
    [
        new("none", "All", "Plain view"),
        new("recency", "Recent", "Warm rims for recently edited pages, faded for old ones"),
        new("links", "Links", "Bodies grow with backlinks"),
        new("orphans", "Orphans", "Spotlight pages with no parent, children or links"),
    ];

    [SupplyParameterFromQuery(Name = "focus")]
    public string? Focus { get; set; }

    private PageGraph _graph = new([], [], []);
    private HashSet<string> _nodeIds = new(StringComparer.Ordinal);
    private List<LegendEntry> _legend = [];
    private readonly HashSet<GraphBodyKind> _hidden = [];
    private Options _opt = new(true, "auto", 1, false, true);

    private DotNetObjectReference<Graph>? _self;
    private bool _mounted;
    private bool _loaded;
    private bool _disposed;
    private bool _settingsOpen;
    private long _loadGeneration;
    private string? _pendingFocus;

    private string _lens = "none";
    private string _query = string.Empty;
    private int _hitCount;
    private CancellationTokenSource? _searchCts;

    private List<GraphNode> _trail = [];

    private bool _timelapse;
    private bool _playing;
    private int _timeValue = 1000;
    private long _timeMin;
    private long _timeMax;
    private CancellationTokenSource? _playCts;

    private string? _selectedId;
    private bool _pinned;
    private GraphPreview? _pinnedPreview;
    private GraphPreview? _preview;
    private GraphNode? _missingPreview;
    private bool _previewVisible;
    private bool _previewHeld;
    private double? _cardX;
    private double? _cardY;
    private double _pinX;
    private double _pinY;
    private string? _hoverId;
    private CancellationTokenSource? _hideCts;
    private CancellationTokenSource? _previewCts;

    private MenuState? _menu;
    private bool _renaming;
    private bool _confirmDelete;
    private string _renameText = string.Empty;

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        State.Workspace.Changed += OnWorkspaceChanged;
        _pendingFocus = Focus;
    }

    protected override Task OnInitializedAsync() =>
        LoadAsync(Interlocked.Increment(ref _loadGeneration));

    protected override void OnParametersSet()
    {
        if (Focus is { Length: > 0 } && Focus != _pendingFocus && Focus != _selectedId)
            _pendingFocus = Focus;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;

        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            try
            {
                _mounted = await Js.InvokeAsync<bool>("synclyGalaxy.mount", CanvasId, _self, new { reducedMotion = false });
                if (_mounted)
                {
                    _opt = await Js.InvokeAsync<Options>("synclyGalaxy.getOptions", CanvasId);
                    if (_loaded)
                        await PushDataAsync();
                    StateHasChanged();
                }
            }
            catch (JSException)
            {
                _mounted = false;
            }
            return;
        }

        if (_renaming && _renameFocusPending)
        {
            _renameFocusPending = false;
            await SafeJsAsync(() => Js.InvokeVoidAsync("syncly.focusElement", RenameId, true).AsTask());
        }
    }

    private bool _renameFocusPending;

    private void OnWorkspaceChanged()
    {
        if (_disposed)
            return;
        var generation = Interlocked.Increment(ref _loadGeneration);
        _ = InvokeAsync(() => LoadAsync(generation));
    }

    private void OnStateChanged()
    {
        if (_disposed)
            return;
        _ = InvokeAsync(async () =>
        {
            await SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.setCurrent", CanvasId, State.CurrentPageId).AsTask());
            StateHasChanged();
        });
    }

    private async Task LoadAsync(long generation)
    {
        var graph = await State.Workspace.GraphAsync();
        if (_disposed || generation != Interlocked.Read(ref _loadGeneration))
            return;

        _graph = graph;
        _nodeIds = graph.Nodes.Select(n => n.Id).ToHashSet(StringComparer.Ordinal);
        _legend = BuildLegend(graph);
        var stamps = graph.Nodes.Where(n => n.CreatedAt != default).Select(n => n.CreatedAt.ToUnixTimeMilliseconds()).ToList();
        _timeMin = stamps.Count > 0 ? stamps.Min() : 0;
        _timeMax = stamps.Count > 0 ? stamps.Max() : 0;
        _loaded = true;

        if (_selectedId is not null && !_nodeIds.Contains(_selectedId))
        {
            _selectedId = null;
            _pinned = false;
            _pinnedPreview = null;
        }

        if (_mounted)
            await PushDataAsync();

        StateHasChanged();
    }

    private static List<LegendEntry> BuildLegend(PageGraph graph) =>
        graph.Nodes
            .GroupBy(n => n.Body)
            .OrderBy(g => (int)g.Key)
            .Select(g => new LegendEntry(g.Key, g.Key.ToString().ToLowerInvariant(), KindLabel(g.Key, plural: true), g.Count()))
            .ToList();

    private Task PushDataAsync()
    {
        var payload = new
        {
            spaceKey = State.CurrentSpaceId,
            currentId = State.CurrentPageId,
            nodes = _graph.Nodes.Select(n => new
            {
                id = n.Id,
                title = n.Title,
                icon = n.Icon,
                x = n.X,
                y = n.Y,
                size = n.Size,
                depth = n.Depth,
                parentId = n.ParentId,
                body = n.Body.ToString().ToLowerInvariant(),
                missing = n.Missing,
                createdAt = n.CreatedAt == default ? 0 : n.CreatedAt.ToUnixTimeMilliseconds(),
                updatedAt = n.UpdatedAt == default ? 0 : n.UpdatedAt.ToUnixTimeMilliseconds(),
                inbound = n.Inbound,
                outbound = n.Outbound,
            }),
            edges = _graph.Edges.Select(e => new { from = e.From, to = e.To }),
        };

        return SafeJsAsync(async () =>
        {
            await Js.InvokeVoidAsync("synclyGalaxy.setData", CanvasId, payload);
            if (_hidden.Count > 0)
                await Js.InvokeVoidAsync("synclyGalaxy.setFilter", CanvasId, _hidden.Select(h => h.ToString().ToLowerInvariant()));
            if (_lens != "none")
                await Js.InvokeVoidAsync("synclyGalaxy.setLens", CanvasId, _lens);
            if (_timelapse)
                await PushTimeCursorAsync();
            if (_query.Length > 0)
                _hitCount = await Js.InvokeAsync<int>("synclyGalaxy.search", CanvasId, _query);
            if (_selectedId is not null)
                await Js.InvokeVoidAsync("synclyGalaxy.select", CanvasId, _selectedId, false);

            if (_pendingFocus is { } focus && _nodeIds.Contains(focus))
            {
                _pendingFocus = null;
                await Js.InvokeVoidAsync("synclyGalaxy.select", CanvasId, focus, true);
                await SelectAsync(focus, null, null);
            }
        });
    }

    // ------------------------------------------------------------- HUD

    private Task FitAsync() => SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.fit", CanvasId, false).AsTask());

    private Task LocateAsync() => SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.locate", CanvasId).AsTask());

    private Task FlyToAsync(string id) => SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.flyTo", CanvasId, id).AsTask());

    private Task ToggleMotionAsync() => SetOptionAsync(o => o with { Motion = !o.Motion });

    private async Task SetOptionAsync(Func<Options, Options> change)
    {
        var next = change(_opt);
        _opt = next;
        await SafeJsAsync(async () =>
        {
            var applied = await Js.InvokeAsync<Options?>("synclyGalaxy.setOptions", CanvasId, new
            {
                motion = next.Motion,
                labels = next.Labels,
                density = next.Density,
                sound = next.Sound,
                effects = next.Effects,
            });
            if (applied is not null)
                _opt = applied;
        });
    }

    private const string LabelsAuto = "auto";
    private const string LabelsAll = "all";
    private const string LabelsMin = "min";

    private Task SetLabelsAsync(string labels) => SetOptionAsync(o => o with { Labels = labels });

    private async Task SetLensAsync(string lens)
    {
        _lens = lens;
        await SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.setLens", CanvasId, lens).AsTask());
    }

    private async Task ToggleKindAsync(GraphBodyKind body)
    {
        if (!_hidden.Remove(body))
            _hidden.Add(body);
        await SafeJsAsync(() => Js.InvokeVoidAsync(
            "synclyGalaxy.setFilter",
            CanvasId,
            _hidden.Select(h => h.ToString().ToLowerInvariant())).AsTask());
    }

    private void OnQueryInput(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        _ = DebouncedSearchAsync(cts.Token);
    }

    private async Task DebouncedSearchAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(140, ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (_disposed)
            return;

        await SafeJsAsync(async () =>
        {
            _hitCount = await Js.InvokeAsync<int>("synclyGalaxy.search", CanvasId, _query);
        });
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnQueryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            await ClearQueryAsync();
    }

    private async Task ClearQueryAsync()
    {
        _query = string.Empty;
        _hitCount = 0;
        _searchCts?.Cancel();
        await SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.search", CanvasId, string.Empty).AsTask());
    }

    // ------------------------------------------------------------- time-lapse

    private async Task ToggleTimelapseAsync()
    {
        _timelapse = !_timelapse;
        StopPlaying();
        if (_timelapse)
        {
            _timeValue = 0;
            await PushTimeCursorAsync();
            await TogglePlayAsync();
        }
        else
        {
            await SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.setTimeCursor", CanvasId, null, 0).AsTask());
        }
    }

    private async Task OnTimeInput(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var value))
        {
            StopPlaying();
            _timeValue = Math.Clamp(value, 0, 1000);
            await PushTimeCursorAsync();
        }
    }

    private async Task TogglePlayAsync()
    {
        if (_playing)
        {
            StopPlaying();
            return;
        }

        if (_timeValue >= 1000)
            _timeValue = 0;

        _playing = true;
        var cts = _playCts = new CancellationTokenSource();
        _ = PlayAsync(cts.Token);
        await Task.CompletedTask;
    }

    private void StopPlaying()
    {
        _playing = false;
        _playCts?.Cancel();
        _playCts = null;
    }

    private async Task PlayAsync(CancellationToken ct)
    {
        const int stepMs = 40;
        var step = Math.Max(1, 1000 * stepMs / (TimelapseSeconds * 1000));
        try
        {
            while (!ct.IsCancellationRequested && _timeValue < 1000)
            {
                await Task.Delay(stepMs, ct);
                _timeValue = Math.Min(1000, _timeValue + step);
                await PushTimeCursorAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!ct.IsCancellationRequested)
        {
            _playing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task PushTimeCursorAsync()
    {
        if (_timeMax <= _timeMin)
            return Task.CompletedTask;
        var span = _timeMax - _timeMin;
        var cursor = _timeMin + span * _timeValue / 1000;
        var window = Math.Max(1000, span * 6 / 100);
        return SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.setTimeCursor", CanvasId, cursor, window).AsTask());
    }

    private string TimeLabel()
    {
        if (_timeMax <= _timeMin)
            return string.Empty;
        var cursor = _timeMin + (_timeMax - _timeMin) * _timeValue / 1000;
        return DateTimeOffset.FromUnixTimeMilliseconds(cursor).ToLocalTime().ToString("d MMM yyyy", CultureInfo.InvariantCulture);
    }

    private int BornCount()
    {
        if (_timeMax <= _timeMin)
            return _graph.Nodes.Count(n => !n.Missing);
        var cursor = _timeMin + (_timeMax - _timeMin) * _timeValue / 1000;
        return _graph.Nodes.Count(n => !n.Missing && (n.CreatedAt == default || n.CreatedAt.ToUnixTimeMilliseconds() <= cursor));
    }

    // ------------------------------------------------------------- callbacks from JS

    [JSInvokable]
    public async Task OnHover(string? id, double clientX, double clientY)
    {
        if (_disposed)
            return;

        _hoverId = id;

        if (id is null)
        {
            if (_pinned && _selectedId is not null)
                await ShowPinnedAsync();
            else
                ScheduleHide();
            return;
        }

        if (id == _selectedId && _pinned)
        {
            _hideCts?.Cancel();
            await ShowPinnedAsync();
            return;
        }

        _hideCts?.Cancel();
        await ShowPreviewAsync(id, clientX, clientY, pinned: false);
    }

    [JSInvokable]
    public Task OnSelect(string? id, double clientX, double clientY) =>
        InvokeAsync(() => SelectAsync(id, clientX, clientY));

    [JSInvokable]
    public Task OnOpen(string id) => InvokeAsync(() => OpenIdAsync(id));

    [JSInvokable]
    public Task OnContextMenu(string? id, double clientX, double clientY) => InvokeAsync(() =>
    {
        var node = id is null ? null : _graph.Nodes.FirstOrDefault(n => n.Id == id);
        _menu = new MenuState(node, clientX, clientY);
        _renaming = false;
        _confirmDelete = false;
        _settingsOpen = false;
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnFocusSystem(string? id) => InvokeAsync(() =>
    {
        var trail = new List<GraphNode>();
        var cursor = id is null ? null : _graph.Nodes.FirstOrDefault(n => n.Id == id);
        var guard = 0;
        while (cursor is not null && guard++ < 64)
        {
            trail.Insert(0, cursor);
            cursor = cursor.ParentId is null ? null : _graph.Nodes.FirstOrDefault(n => n.Id == cursor.ParentId);
        }
        _trail = trail;
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnFocusSearch() =>
        SafeJsAsync(() => Js.InvokeVoidAsync("syncly.focusElement", SearchId, true).AsTask());

    // ------------------------------------------------------------- selection + preview

    private async Task SelectAsync(string? id, double? clientX, double? clientY)
    {
        _menu = null;
        _selectedId = id;

        if (id is null)
        {
            _pinned = false;
            _pinnedPreview = null;
            ScheduleHide();
            StateHasChanged();
            return;
        }

        _pinned = true;
        _hideCts?.Cancel();
        if (clientX is { } x && clientY is { } y)
        {
            _pinX = x;
            _pinY = y;
            _cardX = x;
            _cardY = y;
        }
        else
        {
            _cardX = null;
            _cardY = null;
        }

        await ShowPreviewAsync(id, clientX, clientY, pinned: true);
    }

    private async Task ShowPinnedAsync()
    {
        if (_selectedId is null)
            return;
        _cardX = _cardX is null ? null : _pinX;
        _cardY = _cardY is null ? null : _pinY;
        if (_pinnedPreview is not null)
        {
            _missingPreview = null;
            _preview = _pinnedPreview;
            _previewVisible = true;
            await InvokeAsync(StateHasChanged);
            return;
        }
        await ShowPreviewAsync(_selectedId, _cardX, _cardY, pinned: true);
    }

    private async Task ShowPreviewAsync(string id, double? clientX, double? clientY, bool pinned)
    {
        var node = _graph.Nodes.FirstOrDefault(n => n.Id == id);
        if (node is null)
            return;

        if (clientX is { } x && clientY is { } y)
        {
            _cardX = x;
            _cardY = y;
        }

        if (node.Missing)
        {
            _previewCts?.Cancel();
            _preview = null;
            _missingPreview = node;
            _previewVisible = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _previewCts?.Cancel();
        var cts = _previewCts = new CancellationTokenSource();
        GraphPreview? preview;
        try
        {
            preview = await State.Workspace.PreviewAsync(id, 4, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested || _disposed)
            return;
        if (!pinned && _hoverId != id && !(_pinned && _selectedId == id))
            return;

        if (pinned || id == _selectedId)
            _pinnedPreview = preview;

        _missingPreview = null;
        _preview = preview;
        _previewVisible = preview is not null;
        await InvokeAsync(StateHasChanged);
    }

    private void ScheduleHide()
    {
        _hideCts?.Cancel();
        var cts = _hideCts = new CancellationTokenSource();
        _ = HideAfterAsync(cts.Token);
    }

    private async Task HideAfterAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(180, ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (_disposed || _previewHeld || _hoverId is not null || (_pinned && _selectedId is not null))
            return;

        _previewVisible = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(180, ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (_disposed || _previewVisible)
            return;

        _preview = null;
        _missingPreview = null;
        await InvokeAsync(StateHasChanged);
    }

    private void HoldPreview()
    {
        _previewHeld = true;
        _hideCts?.Cancel();
    }

    private void ReleasePreview()
    {
        _previewHeld = false;
        if (_hoverId is null && !(_pinned && _selectedId is not null))
            ScheduleHide();
    }

    private string PreviewStyle =>
        _cardX is { } x && _cardY is { } y ? $"--px:{F(x)}px;--py:{F(y)}px" : string.Empty;

    private string MenuStyle =>
        _menu is { } m ? $"--px:{F(m.X)}px;--py:{F(m.Y)}px" : string.Empty;

    // ------------------------------------------------------------- context menu actions

    private void CloseMenu()
    {
        _menu = null;
        _renaming = false;
        _confirmDelete = false;
    }

    private void OnMenuKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            CloseMenu();
    }

    private async Task MenuFlyAsync(string id)
    {
        CloseMenu();
        await FlyToAsync(id);
    }

    private async Task MenuFitAsync()
    {
        CloseMenu();
        await FitAsync();
    }

    private async Task MenuToggleMotionAsync()
    {
        CloseMenu();
        await ToggleMotionAsync();
    }

    private async Task NewSubpageAsync(string? parentId)
    {
        CloseMenu();
        if (parentId is not null)
            State.ExpandPage(parentId);
        var pageId = await State.Workspace.CreatePageAsync(parentId);
        State.Open(pageId);
        State.SetReadingMode(false);
        Nav.NavigateTo("");
    }

    private Task StartRenameAsync(GraphNode node)
    {
        _renaming = true;
        _renameText = node.Title;
        _renameFocusPending = true;
        return Task.CompletedTask;
    }

    private async Task OnRenameKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await CommitRenameAsync();
        else if (args.Key == "Escape")
            _renaming = false;
    }

    private async Task CommitRenameAsync()
    {
        if (_menu?.Node is not { } node)
            return;
        var title = _renameText.Trim();
        CloseMenu();
        if (title.Length == 0 || title == node.Title)
            return;
        await State.Workspace.RenamePageAsync(node.Id, title);
    }

    private async Task DuplicateAsync(string id)
    {
        CloseMenu();
        var copy = await State.Workspace.DuplicatePageAsync(id);
        _selectedId = copy;
        _pinned = false;
        _pinnedPreview = null;
        await SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.select", CanvasId, copy, true).AsTask());
    }

    private async Task CopyLinkAsync(string title)
    {
        CloseMenu();
        await SafeJsAsync(() => Js.InvokeVoidAsync("synclyGalaxy.copyText", $"[[{title}]]").AsTask());
    }

    private async Task DeleteAsync(string id)
    {
        if (!_confirmDelete)
        {
            _confirmDelete = true;
            return;
        }

        CloseMenu();
        if (_selectedId == id)
        {
            _selectedId = null;
            _pinned = false;
            _pinnedPreview = null;
            _preview = null;
            _missingPreview = null;
            _previewVisible = false;
        }
        await State.Workspace.DeletePageAsync(id);
        if (State.CurrentPageId == id)
            State.Back();
    }

    // ------------------------------------------------------------- open

    private async Task OpenIdAsync(string id)
    {
        CloseMenu();
        var node = _graph.Nodes.FirstOrDefault(n => n.Id == id);
        if (node is null)
            return;

        if (node.Missing)
        {
            var pageId = await State.Workspace.EnsurePageByTitleAsync(node.Title);
            State.Open(pageId);
        }
        else
        {
            State.Open(node.Id);
        }

        Nav.NavigateTo("");
    }

    // ------------------------------------------------------------- helpers

    private static string KindLabel(GraphBodyKind body, bool plural = false) => body switch
    {
        GraphBodyKind.Star => plural ? "Stars" : "Star",
        GraphBodyKind.Planet => plural ? "Planets" : "Planet",
        GraphBodyKind.Moon => plural ? "Moons" : "Moon",
        GraphBodyKind.Asteroid => plural ? "Asteroids" : "Asteroid",
        GraphBodyKind.Meteor => plural ? "Meteors" : "Meteor",
        _ => plural ? "Unresolved" : "Unresolved",
    };

    private static string Label(GraphNode node) =>
        node.Icon is { Length: > 0 } icon ? $"{icon} {node.Title}" : node.Title;

    private static string Plural(int count, string noun) =>
        $"{count.ToString(CultureInfo.InvariantCulture)} {noun}{(count == 1 ? string.Empty : "s")}";

    private static string Initial(string title)
    {
        var t = title.Trim();
        return t.Length == 0 ? "?" : char.ToUpperInvariant(t[0]).ToString();
    }

    private static string Relative(DateTimeOffset when)
    {
        if (when == default)
            return "never edited";

        var span = DateTimeOffset.Now - when;
        if (span < TimeSpan.FromMinutes(1))
            return "edited just now";
        if (span < TimeSpan.FromHours(1))
            return $"edited {(int)span.TotalMinutes} min ago";
        if (span < TimeSpan.FromDays(1))
            return $"edited {(int)span.TotalHours} h ago";
        if (span < TimeSpan.FromDays(2))
            return "edited yesterday";
        if (span < TimeSpan.FromDays(30))
            return $"edited {(int)span.TotalDays} d ago";
        return "edited " + when.ToLocalTime().ToString("d MMM yyyy", CultureInfo.InvariantCulture);
    }

    private static string F(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private async Task SafeJsAsync(Func<Task> call)
    {
        if (_disposed || !_mounted)
            return;
        try
        {
            await call();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Interlocked.Increment(ref _loadGeneration);
        State.Changed -= OnStateChanged;
        State.Workspace.Changed -= OnWorkspaceChanged;
        _searchCts?.Cancel();
        _hideCts?.Cancel();
        _previewCts?.Cancel();
        _playCts?.Cancel();

        if (_mounted)
        {
            try
            {
                await Js.InvokeVoidAsync("synclyGalaxy.destroy", CanvasId);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        _self?.Dispose();
    }
}
