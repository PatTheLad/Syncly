@page "/graph"
@namespace Syncly.UI.Pages
@implements IAsyncDisposable
@inject EditorState State
@inject NavigationManager Nav
@inject IJSRuntime Js

<div class="graph-page @(_selectedId is not null || _showPages ? "has-inspector" : null) @(_expanded ? "inspector-expanded" : null)" @onkeydown="OnPageKeyDown"
     @oncontextmenu="OnGraphContext"
     @oncontextmenu:preventDefault="true">
    <header class="graph-toolbar" @oncontextmenu:stopPropagation="true"
            @oncontextmenu="OnGraphContext"
            @oncontextmenu:preventDefault="true">
        <div class="graph-heading"><h1>Galaxy</h1><span>@(State.CurrentSpace?.DisplayTitle ?? "This space")</span></div>
        <div class="graph-scope" role="group" aria-label="Graph scope">
            <button type="button" aria-pressed="@(!_connections)" class="@(!_connections ? "active" : null)" @onclick="() => SetScopeAsync(false)">All</button>
            <button type="button" aria-pressed="@_connections" class="@(_connections ? "active" : null)" disabled="@(_selectedId is null)" @onclick="() => SetScopeAsync(true)">Connections</button>
        </div>
        <label class="graph-search">
            <span class="graph-icon icon-search" aria-hidden="true"></span>
            <input id="graph-search" type="search" placeholder="Find a note" aria-label="Find a note" value="@_query" @oninput="OnQueryAsync" @onkeydown="OnSearchKeyDown" />
        </label>
        <div class="graph-toolbar-actions">
            <button class="graph-tool" type="button" title="Pages" aria-label="Pages" aria-pressed="@_showPages" @onclick="TogglePages"><span class="graph-icon icon-list" aria-hidden="true"></span></button>
            <button class="graph-tool" type="button" title="New page" aria-label="New page" disabled="@_busy" @onclick="() => NewPageAsync(null)"><span class="graph-icon icon-file-plus" aria-hidden="true"></span></button>
            <button class="graph-tool" type="button" title="Graph settings" aria-label="Graph settings" aria-expanded="@_settingsOpen" @onclick="() => _settingsOpen = !_settingsOpen"><span class="graph-icon icon-sliders-horizontal" aria-hidden="true"></span></button>
        </div>
    </header>
    <div class="graph-workspace">
    <div class="graph-stage">
        <canvas id="@CanvasId" class="graph-canvas" tabindex="0" aria-label="Note connections. Arrow keys select, Enter opens, Home fits, plus and minus zoom."></canvas>
        <div class="graph-status" aria-live="polite">
            @if (_loaded)
            {
                <span>@_graph.Nodes.Count(node => !node.Missing) notes</span><span class="graph-status-dot"></span><span>@_graph.Edges.Count links</span>
                @if (_filter != "all") { <span class="graph-status-filter">@(_filter == "unlinked" ? "Unlinked" : "Unresolved")</span> }
            }
        </div>
        <div class="graph-camera" role="group" aria-label="Graph camera">
            <button type="button" class="graph-tool" title="Zoom in" aria-label="Zoom in" @onclick='() => CanvasAsync("zoom", 1.25)'><span class="graph-icon icon-plus" aria-hidden="true"></span></button>
            <button type="button" class="graph-tool" title="Zoom out" aria-label="Zoom out" @onclick='() => CanvasAsync("zoom", 0.8)'><span class="graph-icon icon-minus" aria-hidden="true"></span></button>
            <span class="graph-tool-divider"></span>
            <button type="button" class="graph-tool" title="Fit graph" aria-label="Fit graph" @onclick='() => CanvasAsync("fit")'><span class="graph-icon icon-maximize" aria-hidden="true"></span></button>
            <button type="button" class="graph-tool" title="Locate open page" aria-label="Locate open page" disabled="@(State.CurrentPageId is null || !_byId.ContainsKey(State.CurrentPageId))" @onclick="LocateAsync"><span class="graph-icon icon-locate-fixed" aria-hidden="true"></span></button>
        </div>
        @if (_settingsOpen)
        {
            <section class="graph-settings" aria-label="Graph settings">
                <header><h2>View</h2><button type="button" class="graph-tool" title="Close settings" aria-label="Close settings" @onclick="() => _settingsOpen = false"><span class="graph-icon icon-x" aria-hidden="true"></span></button></header>
                <label><span>Notes</span><select aria-label="Filter notes" value="@_filter" @onchange="OnFilterAsync"><option value="all">All notes</option><option value="unlinked">Unlinked</option><option value="unresolved">Unresolved</option></select></label>
                <label><span>Labels</span><input type="checkbox" checked="@_labels" @onchange="ToggleLabelsAsync" /></label>
                <label><span>Recent edits</span><input type="checkbox" checked="@_recent" @onchange="ToggleRecentAsync" /></label>
                <button type="button" class="graph-command" @onclick='() => CanvasAsync("reset")'><span class="graph-icon icon-rotate-ccw" aria-hidden="true"></span>Reset layout</button>
            </section>
        }
        @if (_loadError is not null || _rendererError is not null)
        {
            <div class="graph-state" role="alert"><h2>Graph unavailable</h2><p>@(_loadError ?? _rendererError)</p><button class="graph-primary" @onclick="RetryAsync">Retry</button><button class="graph-command" @onclick="TogglePages">Pages</button></div>
        }
        else if (!_loaded)
        {
            <div class="graph-state" role="status"><span class="graph-loading-mark"></span><p>Loading notes...</p></div>
        }
        else if (_graph.Nodes.Count == 0)
        {
            <div class="graph-state"><span class="graph-empty-mark" aria-hidden="true"></span><h2>No notes yet</h2><button class="graph-primary" disabled="@_busy" @onclick="() => NewPageAsync(null)">Create page</button></div>
        }
        else if (_filter != "all" && !FilteredNodes().Any())
        {
            <div class="graph-state"><h2>No @(_filter == "unlinked" ? "unlinked notes" : "unresolved links")</h2><button class="graph-command" @onclick="ClearFilterAsync">Show all notes</button></div>
        }
    </div>
    @if (_selectedId is not null || _showPages)
    {
        <GraphInspector Node="@(_showPages ? null : SelectedNode)" Preview="@_preview" Pages="@_results"
                        Incoming="@ConnectionsTo(true)" Outgoing="@ConnectionsTo(false)" Loading="@_previewLoading"
                        Error="@_previewError" Busy="@_busy" Expanded="@_expanded" ActionsOpen="@_actionsOpen"
                        Query="@_query" OnSelect="SelectResultAsync" OnOpen="OpenAsync" OnClose="CloseInspectorAsync"
                        OnExpand="ToggleExpanded" OnAction="PageActionAsync" OnToggleActions="() => _actionsOpen = !_actionsOpen" OnRetry="LoadPreviewAsync" />
    }
    </div>
    @if (_notice is not null)
    {
        <div class="graph-notice" role="status"><span>@_notice</span><button class="graph-tool" aria-label="Dismiss" title="Dismiss" @onclick="() => _notice = null"><span class="graph-icon icon-x" aria-hidden="true"></span></button></div>
    }
    @if (_dialog is not null && SelectedNode is { } dialogNode)
    {
        <div class="graph-dialog-backdrop" @onclick="CloseDialog">
            <section class="graph-dialog" role="dialog" aria-modal="true" aria-labelledby="graph-dialog-title" @onclick:stopPropagation="true" @onkeydown="OnDialogKeyDown" @onkeydown:stopPropagation="true">
                <h2 id="graph-dialog-title">@(_dialog == "rename" ? "Rename page" : "Move to trash?")</h2>
                @if (_dialog == "rename")
                {
                    <input id="graph-dialog-input" aria-label="Page title" @bind="_renameText" @bind:event="oninput" @onkeydown="OnRenameKeyDown" />
                }
                else { <p>@dialogNode.Title</p> }
                <footer><button id="graph-dialog-cancel" class="graph-command" disabled="@_busy" @onclick="CloseDialog">Cancel</button><button class="graph-primary @(_dialog == "delete" ? "danger" : null)" disabled="@(_busy || (_dialog == "rename" && string.IsNullOrWhiteSpace(_renameText)))" @onclick="CommitDialogAsync">@(_dialog == "rename" ? "Save" : "Move to trash")</button></footer>
            </section>
        </div>
    }
</div>

@if (_ctxMenu is not null)
{
    <ContextMenu Items="_ctxMenu.Items"
                 Left="_ctxMenu.Left"
                 Top="_ctxMenu.Top"
                 OnClose="CloseCtxMenu" />
}

@code {
    private const string CanvasId = "galaxy-canvas";
    private sealed record ViewOptions(bool Labels, bool Recent);
    private sealed record CtxMenuState(double Left, double Top, IReadOnlyList<ContextMenu.MenuItem> Items);
    [SupplyParameterFromQuery(Name = "focus")] public string? Focus { get; set; }
    private PageGraph _graph = new([], []);
    private Dictionary<string, GraphNode> _byId = new(StringComparer.Ordinal);
    private Dictionary<string, List<GraphNode>> _incoming = new(StringComparer.Ordinal);
    private Dictionary<string, List<GraphNode>> _outgoing = new(StringComparer.Ordinal);
    private List<GraphNode> _results = [];
    private IJSObjectReference? _module;
    private DotNetObjectReference<Graph>? _self;
    private bool _mounted, _disposed, _loaded, _busy, _settingsOpen, _showPages, _expanded, _actionsOpen;
    private bool _connections, _labels = true, _recent, _previewLoading;
    private string? _selectedId, _spaceKey, _pendingFocus, _handledFocus, _dialog, _focusElement;
    private string? _loadError, _rendererError, _previewError, _notice;
    private string _query = string.Empty, _filter = "all", _renameText = string.Empty;
    private long _loadGeneration;
    private GraphPreview? _preview;
    private CancellationTokenSource? _previewCts;
    private CtxMenuState? _ctxMenu;
    private GraphNode? SelectedNode => _selectedId is not null ? _byId.GetValueOrDefault(_selectedId) : null;

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        State.Workspace.Changed += OnWorkspaceChanged;
    }

    protected override Task OnInitializedAsync() => ReloadAsync();

    protected override void OnParametersSet()
    {
        if (Focus != _handledFocus) { _pendingFocus = Focus; _handledFocus = Focus; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender) await MountAsync();
        if (_mounted && _loaded && _pendingFocus is { } focus)
        {
            _pendingFocus = null;
            if (_byId.ContainsKey(focus)) await SelectResultAsync(focus);
            else _notice = "This page is not in the current space.";
            StateHasChanged();
        }
        if (_focusElement is { } element)
        {
            _focusElement = null;
            await CallAsync("focusElement", element);
        }
    }

    private async Task MountAsync()
    {
        try
        {
            _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/galaxy.mjs");
            if (_disposed) { await _module.DisposeAsync(); return; }
            _self ??= DotNetObjectReference.Create(this);
            var options = await _module.InvokeAsync<ViewOptions>("mount", CanvasId, _self);
            _labels = options.Labels;
            _recent = options.Recent;
            _mounted = true;
            _rendererError = null;
            if (_loaded) await PushAsync();
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            _rendererError = "The canvas could not start. Your notes are still available in Pages.";
        }
        if (!_disposed) StateHasChanged();
    }

    private void OnWorkspaceChanged()
    {
        if (!_disposed) _ = InvokeAsync(ReloadAsync);
    }

    private void OnStateChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (_spaceKey != State.CurrentSpaceId) await ReloadAsync();
            else await CanvasAsync("setCurrent", State.CurrentPageId);
            if (!_disposed) StateHasChanged();
        });
    }

    private async Task ReloadAsync()
    {
        var generation = Interlocked.Increment(ref _loadGeneration);
        var space = State.CurrentSpaceId;
        try
        {
            var graph = await State.Workspace.GraphAsync();
            if (_disposed || generation != Interlocked.Read(ref _loadGeneration) || space != State.CurrentSpaceId) return;
            if (_spaceKey != space)
            {
                _selectedId = null;
                _connections = _showPages = _expanded = _actionsOpen = false;
                _query = string.Empty;
                _filter = "all";
                _dialog = _notice = null;
                _previewCts?.Cancel();
                _preview = null;
            }
            _spaceKey = space;
            _graph = graph;
            _byId = graph.Nodes.ToDictionary(node => node.Id, StringComparer.Ordinal);
            _incoming = graph.Edges.GroupBy(edge => edge.To).ToDictionary(group => group.Key,
                group => group.Select(edge => _byId[edge.From]).DistinctBy(node => node.Id).OrderBy(node => node.Title, StringComparer.OrdinalIgnoreCase).ToList(), StringComparer.Ordinal);
            _outgoing = graph.Edges.GroupBy(edge => edge.From).ToDictionary(group => group.Key,
                group => group.Select(edge => _byId[edge.To]).DistinctBy(node => node.Id).OrderBy(node => node.Title, StringComparer.OrdinalIgnoreCase).ToList(), StringComparer.Ordinal);
            if (_selectedId is not null && !_byId.ContainsKey(_selectedId))
            {
                _selectedId = null;
                _connections = false;
                _dialog = null;
                _preview = null;
                _previewCts?.Cancel();
                _notice = "The selected page is no longer in this space.";
            }
            _loaded = true;
            _loadError = null;
            UpdateResults();
            await PushAsync();
            if (_selectedId is not null) await LoadPreviewAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            if (!_disposed && generation == Interlocked.Read(ref _loadGeneration)) _loadError = "The notes could not be loaded. Try again.";
        }
        if (!_disposed) StateHasChanged();
    }

    private async Task PushAsync()
    {
        await CanvasAsync("update", new { spaceKey = _spaceKey, currentId = State.CurrentPageId,
            nodes = _graph.Nodes, edges = _graph.Edges.Select(edge => new { from = edge.From, to = edge.To }) });
        await CanvasAsync("select", _selectedId, false);
        await ConfigureAsync();
    }

    private IEnumerable<GraphNode> FilteredNodes() => _graph.Nodes.Where(node =>
        (_filter != "unlinked" || (!node.Missing && node.Inbound + node.Outbound == 0))
        && (_filter != "unresolved" || node.Missing)
        && (!_connections || node.Id == _selectedId || ConnectionsTo(true).Any(other => other.Id == node.Id) || ConnectionsTo(false).Any(other => other.Id == node.Id)));

    private void UpdateResults() => _results = FilteredNodes()
        .Where(node => node.Title.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase))
        .OrderBy(node => node.Title, StringComparer.OrdinalIgnoreCase).ToList();

    private IReadOnlyList<GraphNode> ConnectionsTo(bool incoming) => _selectedId is null ? []
        : (incoming ? _incoming : _outgoing).GetValueOrDefault(_selectedId) ?? [];

    private Task ConfigureAsync() => CanvasAsync("configure", new { mode = _connections ? "connections" : "all", filter = _filter, query = _query, labels = _labels, recent = _recent });

    private async Task SetScopeAsync(bool connections)
    {
        _connections = connections && _selectedId is not null;
        UpdateResults();
        await ConfigureAsync();
    }

    private async Task OnQueryAsync(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        _showPages = _expanded = true;
        _settingsOpen = false;
        UpdateResults();
        await ConfigureAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && _results.Count > 0) await SelectResultAsync(_results[0].Id);
        else if (args.Key == "ArrowDown") await CallAsync("focusElement", "graph-result-0");
    }

    private async Task OnFilterAsync(ChangeEventArgs args)
    {
        _filter = args.Value?.ToString() ?? "all";
        UpdateResults();
        await ConfigureAsync();
        await CanvasAsync("fit");
    }

    private Task ClearFilterAsync() => OnFilterAsync(new ChangeEventArgs { Value = "all" });
    private async Task ToggleLabelsAsync(ChangeEventArgs args) { _labels = args.Value is true; await ConfigureAsync(); }
    private async Task ToggleRecentAsync(ChangeEventArgs args) { _recent = args.Value is true; await ConfigureAsync(); }
    private void TogglePages() { _showPages = !_showPages; _expanded = _showPages; _settingsOpen = false; UpdateResults(); }
    private void ToggleExpanded() => _expanded = !_expanded;

    private async Task SelectAsync(string? id, bool center)
    {
        if (_disposed) return;
        _selectedId = id is not null && _byId.ContainsKey(id) ? id : null;
        _showPages = _actionsOpen = false;
        _dialog = null;
        if (_selectedId is null) _connections = false;
        UpdateResults();
        await CanvasAsync("select", _selectedId, center);
        await ConfigureAsync();
        if (_connections && center) await CanvasAsync("fit");
        await LoadPreviewAsync();
        if (!_disposed) StateHasChanged();
    }

    private async Task SelectResultAsync(string id)
    {
        await SelectAsync(id, true);
        _focusElement = CanvasId;
    }

    private async Task LoadPreviewAsync()
    {
        _previewCts?.Cancel();
        _previewCts?.Dispose();
        _previewCts = null;
        _preview = null;
        _previewError = null;
        _previewLoading = false;
        if (SelectedNode is not { Missing: false } node) return;
        var cts = _previewCts = new CancellationTokenSource();
        _previewLoading = true;
        StateHasChanged();
        try
        {
            var preview = await State.Workspace.PreviewAsync(node.Id, 5, cts.Token);
            if (!_disposed && !cts.IsCancellationRequested && node.Id == _selectedId) _preview = preview;
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            if (!_disposed && !cts.IsCancellationRequested) _previewError = "Preview unavailable.";
        }
        finally
        {
            if (!_disposed && !cts.IsCancellationRequested) { _previewLoading = false; StateHasChanged(); }
        }
    }

    private async Task CloseInspectorAsync()
    {
        _showPages = _expanded = false;
        _query = string.Empty;
        await SelectAsync(null, false);
        _focusElement = CanvasId;
    }

    private Task LocateAsync() => State.CurrentPageId is { } id ? SelectResultAsync(id) : Task.CompletedTask;
    [JSInvokable] public Task OnSelect(string? id) => InvokeAsync(() => SelectAsync(id, false));
    [JSInvokable] public Task OnOpen(string id) => InvokeAsync(() => OpenAsync(id));
    [JSInvokable] public Task OnFocusSearch() => CallAsync("focusElement", "graph-search");
    [JSInvokable] public Task OnEscape() => InvokeAsync(EscapeAsync);
    [JSInvokable] public Task OnContext(string? id, double x, double y) => InvokeAsync(async () =>
    {
        if (_disposed) return;
        if (id is not null)
            await SelectAsync(id, false);

        OnGraphContextAt(x, y);
        StateHasChanged();
    });

    private async Task EscapeAsync()
    {
        if (_ctxMenu is not null) { _ctxMenu = null; }
        else if (_dialog is not null) CloseDialog();
        else if (_actionsOpen) _actionsOpen = false;
        else if (_settingsOpen) _settingsOpen = false;
        else if (_showPages && _selectedId is not null) { _showPages = false; _query = string.Empty; await ConfigureAsync(); }
        else await CloseInspectorAsync();
        if (!_disposed) StateHasChanged();
    }

    private Task OnPageKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? EscapeAsync() : Task.CompletedTask;
    private void CloseDialog() { _dialog = null; _focusElement = "graph-page-actions"; }
    private Task OnDialogKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? EscapeAsync() : Task.CompletedTask;
    private Task OnRenameKeyDown(KeyboardEventArgs args) => args.Key == "Enter" ? CommitDialogAsync() : Task.CompletedTask;

    private void OnGraphContext(MouseEventArgs e) => OnGraphContextAt(e.ClientX, e.ClientY);

    private void OnGraphContextAt(double x, double y)
    {
        var items = new List<ContextMenu.MenuItem>
        {
            new("New page", () => NewPageAsync(null), "+"),
            new("Fit graph", () => CanvasAsync("fit"), "⛶"),
            new("Reset layout", () => CanvasAsync("reset"), "↺"),
            new(_showPages ? "Hide pages" : "Show pages", () => { TogglePages(); return Task.CompletedTask; }, "☰"),
        };

        if (SelectedNode is { Missing: false } node)
        {
            items.InsertRange(0,
            [
                new("Open page", () => OpenAsync(node.Id), "↗"),
                new("Rename", () => PageActionAsync("rename"), "✎"),
                new("Duplicate", () => PageActionAsync("duplicate"), "⧉"),
                new("New sub-page", () => PageActionAsync("child"), "+"),
                new("Copy [[link]]", () => PageActionAsync("copy"), "⧉"),
                new("Delete", () => PageActionAsync("delete"), "✕", Danger: true),
            ]);
        }

        _ctxMenu = new(x, y, items);
    }

    private Task CloseCtxMenu()
    {
        _ctxMenu = null;
        return Task.CompletedTask;
    }

    private Task PageActionAsync(string action)
    {
        if (SelectedNode is not { } node || _busy) return Task.CompletedTask;
        _actionsOpen = false;
        switch (action)
        {
            case "rename":
            case "delete":
                _dialog = action;
                _renameText = node.Title;
                _focusElement = action == "rename" ? "graph-dialog-input" : "graph-dialog-cancel";
                return Task.CompletedTask;
            case "copy": return RunActionAsync(async () =>
            {
                if (_module is null) throw new InvalidOperationException("Graph module is unavailable.");
                await _module.InvokeVoidAsync("copyText", $"[[{node.Title}]]");
                _notice = "Link copied.";
            });
            case "child": return NewPageAsync(node.Id);
            case "duplicate": return RunActionAsync(async () =>
            {
                var copy = await State.Workspace.DuplicatePageAsync(node.Id);
                await ReloadAsync();
                await SelectResultAsync(copy);
            });
            default: return Task.CompletedTask;
        }
    }

    private Task CommitDialogAsync()
    {
        if (SelectedNode is not { } node) return Task.CompletedTask;
        var action = _dialog;
        var title = _renameText.Trim();
        if (action == "rename" && title.Length == 0) return Task.CompletedTask;
        return RunActionAsync(async () =>
        {
            if (action == "rename") await State.Workspace.RenamePageAsync(node.Id, title);
            else if (action == "delete")
            {
                await State.Workspace.DeletePageAsync(node.Id);
                if (State.CurrentPageId == node.Id) State.Back();
            }
            CloseDialog();
            await ReloadAsync();
        });
    }

    private Task OpenAsync(string id) => RunActionAsync(async () =>
    {
        if (!_byId.TryGetValue(id, out var node)) return;
        var pageId = node.Missing ? await State.Workspace.EnsurePageByTitleAsync(node.Title) : node.Id;
        State.Open(pageId);
        Nav.NavigateTo("");
    });

    private Task NewPageAsync(string? parentId) => RunActionAsync(async () =>
    {
        if (parentId is not null) State.ExpandPage(parentId);
        var pageId = await State.Workspace.CreatePageAsync(parentId);
        State.Open(pageId);
        State.SetReadingMode(false);
        Nav.NavigateTo("");
    });

    private async Task RunActionAsync(Func<Task> action)
    {
        if (_busy || _disposed) return;
        _busy = true;
        try { await action(); }
        catch (Exception) { if (!_disposed) _notice = "The action could not be completed. Please try again."; }
        finally { _busy = false; if (!_disposed) StateHasChanged(); }
    }

    private async Task RetryAsync()
    {
        if (_rendererError is not null) await MountAsync();
        await ReloadAsync();
    }

    private Task CanvasAsync(string method, params object?[] args) => CallAsync(method, new object?[] { CanvasId }.Concat(args).ToArray());
    private async Task CallAsync(string method, params object?[] args)
    {
        if (_disposed || !_mounted || _module is null) return;
        try { await _module.InvokeVoidAsync(method, args); }
        catch (JSDisconnectedException) { }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            _rendererError = "The graph stopped responding. Retry to restore the view.";
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Interlocked.Increment(ref _loadGeneration);
        State.Changed -= OnStateChanged;
        State.Workspace.Changed -= OnWorkspaceChanged;
        _previewCts?.Cancel();
        _previewCts?.Dispose();
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("destroy", CanvasId); await _module.DisposeAsync(); }
            catch (Exception exception) when (exception is JSException or InvalidOperationException) { }
        }
        _self?.Dispose();
    }
}