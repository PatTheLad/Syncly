@page "/sync"
@inject AppState State
@implements IDisposable

<h1>Sync</h1>
<p class="lede">Detected → Authenticate → Sync changes → Up to date.</p>

@{
    var phase = State.Host.LastProgress.Phase;
}

<div class="flow">
    <div class="flow-step @StepClass(SyncPhase.Discovering, SyncPhase.Connecting)">Detected</div>
    <div class="flow-step @StepClass(SyncPhase.Authenticating, SyncPhase.AwaitingTrust)">Authenticate</div>
    <div class="flow-step @StepClass(SyncPhase.Syncing)">Sync changes…</div>
    <div class="flow-step @StepClass(SyncPhase.UpToDate)">Up to date</div>
</div>

<div class="panel">
    <p>
        <strong>Status:</strong> @phase
        @if (!string.IsNullOrEmpty(State.Host.LastProgress.PeerName))
        {
            <span>· @State.Host.LastProgress.PeerName</span>
        }
    </p>
    <p class="lede">@State.Host.LastProgress.Message</p>
</div>

@code {
    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;

    private string StepClass(params SyncPhase[] phases)
    {
        var current = State.Host.LastProgress.Phase;
        if (current == SyncPhase.Failed) return "";
        if (phases.Contains(current)) return "active";
        if (current == SyncPhase.UpToDate) return "done";
        // mark earlier steps done
        var order = new[]
        {
            SyncPhase.Idle, SyncPhase.Discovering, SyncPhase.Connecting,
            SyncPhase.Authenticating, SyncPhase.AwaitingTrust, SyncPhase.Syncing, SyncPhase.UpToDate
        };
        var curIdx = Array.IndexOf(order, current);
        var stepIdx = phases.Select(p => Array.IndexOf(order, p)).Where(i => i >= 0).DefaultIfEmpty(99).Min();
        return curIdx > stepIdx ? "done" : "";
    }
}
