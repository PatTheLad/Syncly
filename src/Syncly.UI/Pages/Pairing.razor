@page "/pairing"
@inject AppState State
@inject IDeviceIdentity Identity
@inject ITrustStore Trust
@implements IDisposable

<div class="page">
    <h1>Pairing</h1>
    <p class="lede">Nearby discovery only proves a Syncly app is present. Confirm fingerprints before trusting a device.</p>

    <div class="panel">
        <h2 style="font-family:var(--font-note);font-weight:600;margin:0 0 0.45rem;font-size:1.15rem">This device</h2>
        <p>@Identity.Current.DisplayName</p>
        <p class="fingerprint">@Identity.Current.PublicKeyFingerprint</p>
    </div>

    @if (State.Pairing.PendingRemote is { } pending)
    {
        <div class="panel">
            <h2 style="font-family:var(--font-note);font-weight:600;margin:0 0 0.45rem;font-size:1.15rem">Trust request</h2>
            <p>@pending.DisplayName wants to sync.</p>
            <p class="fingerprint">@pending.PublicKeyFingerprint</p>
            <div class="row">
                <button @onclick="() => Respond(true)">Trust</button>
                <button class="danger" @onclick="() => Respond(false)">Reject</button>
            </div>
        </div>
    }

    <section class="panel">
        <h2 style="font-family:var(--font-note);font-weight:600;margin:0 0 0.75rem;font-size:1.15rem">Trusted peers</h2>
        @if (_trusted.Count == 0)
        {
            <p class="lede">None yet.</p>
        }
        else
        {
            @foreach (var peer in _trusted)
            {
                <div class="peer row">
                    <div>
                        <strong>@peer.DisplayName</strong>
                        <span class="fingerprint">@peer.Fingerprint</span>
                    </div>
                    <button class="danger" @onclick="() => RevokeAsync(peer.DeviceId)">Revoke</button>
                </div>
            }
        }
    </section>
</div>

@code {
    private List<TrustedPeer> _trusted = new();

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        await ReloadAsync();
    }

    private async void OnChanged()
    {
        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadAsync() => _trusted = (await Trust.ListAsync()).ToList();
    private void Respond(bool accept) => State.Pairing.Respond(accept);

    private async Task RevokeAsync(string id)
    {
        await Trust.RevokeAsync(id);
        await ReloadAsync();
    }

    public void Dispose() => State.Changed -= OnChanged;
}
