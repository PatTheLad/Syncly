@page "/devices"
@inject AppState State
@inject IDeviceIdentity Identity
@implements IDisposable

<div class="page">
    <h1>Devices</h1>
    <p class="lede">Find nearby Syncly peers on your network. Discovery is not trust — confirm fingerprints when prompted.</p>

    <div class="panel row">
        <div>
            <span class="status-dot @(State.Host.IsDiscoverable ? "" : "off")"></span>
            @(State.Host.IsDiscoverable ? "Discoverable" : "Hidden")
            <div class="lede" style="margin:0.35rem 0 0">@Identity.Current.DisplayName</div>
        </div>
        <button @onclick="ToggleDiscoverable" disabled="@_busy">
            @(State.Host.IsDiscoverable ? "Go hidden" : "Become discoverable")
        </button>
    </div>

    <section class="panel">
        <h2 style="font-family:var(--font-note);font-weight:600;margin:0 0 0.75rem;font-size:1.2rem">Nearby</h2>
        @if (!State.Host.NearbyPeers.Any())
        {
            <p class="lede">No peers yet. Enable discoverable here and on another device.</p>
        }
        else
        {
            @foreach (var peer in State.Host.NearbyPeers)
            {
                <div class="peer row">
                    <div>
                        <strong><span class="status-dot"></span>@peer.DisplayName</strong>
                        <span style="color:var(--muted);font-size:0.85rem">@peer.Endpoint.Host:@peer.Endpoint.Port</span>
                    </div>
                    <button @onclick="() => SyncAsync(peer)" disabled="@_busy">Sync</button>
                </div>
            }
        }
    </section>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p style="color:var(--danger)">@_error</p>
    }
</div>

@code {
    private bool _busy;
    private string? _error;

    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;

    private async Task ToggleDiscoverable()
    {
        _busy = true;
        _error = null;
        try { await State.Host.SetDiscoverableAsync(!State.Host.IsDiscoverable); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SyncAsync(Peer peer)
    {
        _busy = true;
        _error = null;
        try { await State.Host.SyncWithAsync(peer); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
