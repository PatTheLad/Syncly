@page "/devices"
@namespace Syncly.UI.Pages
@implements IDisposable
@inject SynclyApp App

<div class="workspace">
    <div class="topbar">
        <div class="crumbs"><span class="crumb-current">Devices</span></div>
        <div class="topbar-actions">
            <span class="chip muted">@string.Join(" · ", App.Sync.TransportNames)</span>
            <button class="chip primary" @onclick="() => App.Sync.SyncNowAsync()">Sync now</button>
        </div>
    </div>

    <div class="editor-scroll">
        <div class="page">
            <section>
                <h2>This device</h2>
                <div class="card">
                    <div class="card-title">@App.Identity.DisplayName</div>
                    <div class="card-sub">@App.Identity.DeviceId</div>
                    <div class="card-sub">Listening for peers on the local network.</div>
                </div>
            </section>

            <section>
                <h2>Active sessions</h2>
                @if (App.Sync.Sessions.Count == 0)
                {
                    <div class="panel-empty">Nothing connected right now.</div>
                }
                else
                {
                    @foreach (var session in App.Sync.Sessions)
                    {
                        <div class="card" @key="session.DeviceId">
                            <div class="row">
                                <span class="status-dot @PhaseClass(session.Phase)"></span>
                                <span class="card-title grow">@session.DisplayName</span>
                                <span class="chip muted">@session.Phase</span>
                            </div>
                            <div class="card-sub">
                                @(session.Detail ?? "—") · sent @session.OpsSent · received @session.OpsReceived
                            </div>
                        </div>
                    }
                }
            </section>

            <section>
                <h2>Nearby</h2>
                @if (App.Sync.DiscoveredPeers.Count == 0)
                {
                    <div class="panel-empty">
                        No devices found yet. Both devices must be on the same network with Syncly open.
                    </div>
                }
                else
                {
                    @foreach (var peer in App.Sync.DiscoveredPeers)
                    {
                        <div class="card" @key="peer.DeviceId + peer.Endpoint">
                            <div class="row">
                                <span class="card-title grow">@peer.DisplayName</span>
                                <span class="chip muted">@peer.Transport</span>
                                <button class="chip" @onclick="() => ConnectAsync(peer.Address, peer.Port)">
                                    Connect
                                </button>
                            </div>
                            <div class="card-sub">@peer.Endpoint · seen @peer.SeenAt.ToLocalTime().ToString("t")</div>
                        </div>
                    }
                }
            </section>

            <section>
                <h2>Connect manually</h2>
                <div class="card">
                    <div class="row">
                        <input class="field grow" placeholder="192.168.1.42" @bind="_address" />
                        <input class="field port" type="number" @bind="_port" />
                        <button class="chip primary" @onclick="() => ConnectAsync(_address, _port)">Connect</button>
                    </div>
                    @if (_error is { Length: > 0 })
                    {
                        <div class="card-sub error">@_error</div>
                    }
                </div>
            </section>

            <section>
                <h2>Paired devices</h2>
                @if (_trusted.Count == 0)
                {
                    <div class="panel-empty">Nothing paired yet.</div>
                }
                else
                {
                    @foreach (var device in _trusted)
                    {
                        <div class="card" @key="device.DeviceId">
                            <div class="row">
                                <span class="card-title grow">@device.DisplayName</span>
                                <button class="chip danger" @onclick="() => RevokeAsync(device.DeviceId)">
                                    Unpair
                                </button>
                            </div>
                            <div class="card-sub">
                                @device.DeviceId · paired @device.TrustedAt.ToLocalTime().ToString("g")
                            </div>
                        </div>
                    }
                }
            </section>
        </div>
    </div>
</div>

@code {
    private List<TrustedDevice> _trusted = [];
    private string _address = string.Empty;
    private int _port = 45_654;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        App.Sync.Changed += Refresh;
        await LoadAsync();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync() => _trusted = await App.Peers.ListAsync();

    private async Task ConnectAsync(string address, int port)
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(address))
        {
            _error = "Enter an address first.";
            return;
        }

        try
        {
            await App.Sync.ConnectAsync(address.Trim(), port);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task RevokeAsync(string deviceId)
    {
        await App.Peers.RevokeAsync(deviceId);
        await LoadAsync();
    }

    private static string PhaseClass(SyncPhase phase) => phase switch
    {
        SyncPhase.Live => "live",
        SyncPhase.Failed => "failed",
        _ => "working",
    };

    public void Dispose() => App.Sync.Changed -= Refresh;
}
