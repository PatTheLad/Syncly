        }
    }

    public async ValueTask DisposeAsync()
    {
        State.Changed -= Refresh;
        State.Workspace.Changed -= Refresh;
        App.Sync.Changed -= Refresh;

        if (_saveTimer is not null)
            await _saveTimer.DisposeAsync();

        _jsSelf?.Dispose();
    }
