    public void BeginBlockDrag(string blockId)
    {
        _dragBlockId = blockId;
        _blockHoverId = null;
        _blockHoverEdge = null;
    }

    public void EndBlockDrag()
    {
        _dragBlockId = null;
        _blockHoverId = null;
        _blockHoverEdge = null;
        StateHasChanged();
    }

    public async Task BlockDragOverAsync(string targetId, DragEventArgs e)
    {
        if (_dragBlockId is null || _dragBlockId == targetId)
        {
            _blockHoverId = null;
            return;
        }

        _blockHoverId = targetId;
        try
        {
            _blockHoverEdge = await Js.InvokeAsync<string>("syncly.blockDropHint", targetId, e.ClientX, e.ClientY);
        }
        catch (JSException)
        {
            _blockHoverEdge = "after";
        }
        catch (JSDisconnectedException)
        {
            _blockHoverEdge = "after";
        }
    }

    public async Task DropBlockAsync(string targetId, DragEventArgs e)
    {
        var dragged = _dragBlockId;
        var edge = "after";
        try
        {
            edge = await Js.InvokeAsync<string>("syncly.blockDropHint", targetId, e.ClientX, e.ClientY);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }

        EndBlockDrag();
        if (dragged is null || dragged == targetId)
            return;

        await FlushAsync();
        await State.Workspace.ReorderBlockAsync(PageIdOrThrow, dragged, targetId, after: edge == "after");
    }

    public string? BlockDropClass(string blockId)
    {
        if (_blockHoverId != blockId)
            return null;

        return _blockHoverEdge == "before" ? "drop-before" : "drop-after";
    }

    // ----------------------------------------------------------------- pages

    private string PageIdOrThrow =>
        _page?.Id ?? throw new InvalidOperationException("No page is open.");

    private IReadOnlyList<PageRef> Breadcrumbs()
    {
        var crumbs = new List<PageRef>();
        var cursor = _page?.ParentId;

        while (cursor is not null && State.Workspace.Page(cursor) is { } parent)
        {
            crumbs.Insert(0, parent);
            cursor = parent.ParentId;
        }

        return crumbs;
    }

    private IReadOnlyList<BlockNode> Outline() =>
        _snapshot.Flatten().Where(b => b.Kind.IsHeading() && b.Text.Length > 0).ToList();

