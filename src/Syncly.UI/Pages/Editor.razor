    private async Task DeletePageAsync()
    {
        var title = _page?.DisplayTitle ?? "this page";
        if (!await Js.InvokeAsync<bool>("syncly.confirm", $"Delete “{title}”? The page is removed on every device after the next sync."))
            return;

        var pageId = PageIdOrThrow;
        await State.Workspace.DeletePageAsync(pageId);

        _loadedPageId = null;
        _page = null;
        _panelOpen = false;
        State.Back();
        await SyncFromStateAsync();
    }

