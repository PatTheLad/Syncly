    private async Task TriggerAttachAsync()
    {
        try
        {
            await using var picked = await Files.PickAsync();
            if (picked is not null)
            {
                if (_replaceBlockId is { } replaceId)
                {
                    _replaceBlockId = null;
                    await ReplaceStreamAsync(picked.Content, picked.FileName, picked.MimeType, replaceId);
                }
                else
                {
                    await AttachStreamAsync(picked.Content, picked.FileName, picked.MimeType);
                }
                return;
            }
        }
        catch (Exception ex)
        {
            _saveHint = ex.Message;
            StateHasChanged();
        }

        await Js.InvokeVoidAsync("syncly.click", "syncly-attach");
    }

    private async Task OnAttachInputAsync(InputFileChangeEventArgs args)
    {
        var files = args.GetMultipleFiles(10);
        if (files.Count == 0)
            return;

        var replaceId = _replaceBlockId;
        var after = _attachAfterBlockId;
        _replaceBlockId = null;
        _attachAfterBlockId = null;

        try
        {
            foreach (var file in files)
            {
                if (file.Size > BlobStore.MaxBytes)
                {
                    _saveHint = $"Files larger than {BlobStore.MaxBytes / (1024 * 1024)} MB cannot be attached yet.";
                    StateHasChanged();
                    continue;
                }

                await using var stream = file.OpenReadStream(BlobStore.MaxBytes);
                if (replaceId is not null)
                {
                    await ReplaceStreamAsync(stream, file.Name, file.ContentType, replaceId);
                    after = replaceId;
                    replaceId = null;
                }
                else
                {
                    after = await AttachStreamAsync(stream, file.Name, file.ContentType, after);
                }
            }
        }
        catch (Exception ex)
        {
            _saveHint = ex.Message;
            StateHasChanged();
        }

        try
        {
            await Js.InvokeVoidAsync("syncly.clearInput", "syncly-attach");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task<string?> AttachStreamAsync(Stream stream, string fileName, string? mime, string? after = null)
    {
        await FlushAsync();
        _saveHint = "Attaching…";
        StateHasChanged();

        after ??= _attachAfterBlockId;
        _attachAfterBlockId = null;

        try
        {
            var blockId = await State.Workspace.AttachFileAsync(PageIdOrThrow, stream, fileName, mime, after);
            _saveHint = "Saved";
            if (App.Sync.IsConfigured)
                _ = App.Sync.SyncNowAsync();
            StateHasChanged();
            return blockId;
        }
        catch (Exception ex)
        {
            _saveHint = ex.Message;
            StateHasChanged();
            return null;
        }
    }

    private async Task ReplaceStreamAsync(Stream stream, string fileName, string? mime, string blockId)
    {
        await FlushAsync();
        _saveHint = "Attaching…";
        StateHasChanged();

        try
        {
            await State.Workspace.ReplaceFileAsync(PageIdOrThrow, blockId, stream, fileName, mime);
            _saveHint = "Saved";
            if (App.Sync.IsConfigured)
                _ = App.Sync.SyncNowAsync();
        }
        catch (Exception ex)
        {
            _saveHint = ex.Message;
        }

        StateHasChanged();
    }

    private async Task StopEditingAsync()
    {
        await FlushAsync();
        _focusedBlockId = null;
        State.SetReadingMode(true);
    }

    private async Task FocusBlockAsync(string blockId, int caret)
    {
        _focusedBlockId = blockId;
        State.SetReadingMode(false);
        _focusRequest = (blockId, caret);
        StateHasChanged();
        await Task.Yield();
    }

    private async Task<int> CaretAsync(string blockId)
    {
        try
        {
            return await Js.InvokeAsync<int>("syncly.getCaret", $"blk-{blockId}");
        }
        catch (JSException)
        {
