@page "/settings"
@namespace Syncly.UI.Pages
@implements IDisposable
@inject SynclyApp App
@inject EditorState State
@inject IJSRuntime Js
@inject IAppUpdater Updater
@inject IQrScanner QrScanner
@inject IDeviceCamera Camera
@inject IMailboxCapabilities Mailbox

<div class="workspace">
    <div class="topbar">
        <div class="crumbs"><span class="crumb-current">Settings</span></div>
    </div>

    <div class="editor-scroll">
        <div class="page">
            <section>
                <h2>Sync</h2>
                <p class="lede">Devices share a mailbox — a folder or Proton Drive — and a 24-word chain code. The mailbox only ever sees ciphertext.</p>

                <div class="card">
                    <div class="card-title">Mailbox</div>
                    <div class="row wrap">
                        @if (Mailbox.SupportsLocalFolder)
                        {
                            <button class="chip @(_prefs.Backend == SyncBackendKind.Folder ? "primary" : null)"
                                    @onclick="() => SetBackendAsync(SyncBackendKind.Folder)">
                                Local folder
                            </button>
                        }
                        <button class="chip @(_prefs.Backend == SyncBackendKind.Cloud ? "primary" : null)"
                                @onclick="() => SetBackendAsync(SyncBackendKind.Cloud)">
                            Cloud
                        </button>
                    </div>

                    @if (!Mailbox.SupportsLocalFolder && _prefs.Backend == SyncBackendKind.Folder)
                    {
                        <div class="card-sub error">
                            Local folders are desktop-only on this device. Switch to Proton Drive to sync.
                        </div>
                        <div class="row">
                            <button class="chip primary" @onclick="() => SetBackendAsync(SyncBackendKind.Cloud)">
                                Use Cloud
                            </button>
                        </div>
                    }
                    else if (_prefs.Backend == SyncBackendKind.Folder)
                    {
                        <div class="card-sub">A folder on this machine, a USB stick, or a network share both devices can see.</div>
                        <div class="row">
                            <input class="field grow" placeholder="C:\SynclyMailbox" @bind="_prefs.FolderPath" @bind:event="oninput" />
                            <button class="chip" @onclick="SaveMailboxAsync">Save</button>
                        </div>
                    }
                    else if (_prefs.Backend == SyncBackendKind.Cloud)
                    {
                        <div class="row wrap">
                            <span class="chip primary">Proton Drive</span>
                            <span class="card-sub">More providers later</span>
                        </div>
                        <div class="card-sub">
                            In Proton Drive, share a folder → public link → <strong>Editor</strong>. Paste the full URL, including the part after # (usually 12 characters). If you turned on “Require password”, type that separate password below — not the # secret again.
                        </div>
                        <div class="row">
                            <input class="field grow" placeholder="https://drive.proton.me/urls/…#…"
                                   @bind="_prefs.ProtonShareUrl" @bind:event="oninput" />
                        </div>
                        <div class="row">
                            <input class="field grow" type="password" autocomplete="off"
                                   placeholder="Share password (optional)"
                                   @bind="_prefs.ProtonSharePassword" @bind:event="oninput" />
                        </div>
                        <div class="row">
                            <button class="chip" @onclick="SaveMailboxAsync">Save</button>
                            <button class="chip" @onclick="TestMailboxAsync">Test connection</button>
                        </div>
                    }
                    else if (!Mailbox.SupportsLocalFolder)
                    {
                        <div class="card-sub">On this device, sync uses Proton Drive. Paste an Editor share link below after choosing Cloud, or scan an invite QR from desktop.</div>
                    }

                    @if (_mailboxMessage is { Length: > 0 })
                    {
                        <div class="card-sub @(_mailboxError ? "error" : null)">@_mailboxMessage</div>
                    }
                </div>

                <div class="card">
                    <div class="card-title">Chain code</div>
                    <div class="card-sub">
                        Same idea as Brave Sync: 24 words (or a QR) are the encryption key. Anyone with the code can read this mailbox.
                        When a Proton mailbox is saved, the QR also carries the share link and password so a phone can join in one scan.
                    </div>

                    @if (App.Sync.Chain is { } chain)
                    {
                        <div class="row wrap">
                            <button class="chip" @onclick="() => _revealChain = !_revealChain">
                                @(_revealChain ? "Hide words" : "Show words")
                            </button>
                            <button class="chip" @onclick="() => CopyAsync(chain.Words)">Copy words</button>
                            <button class="chip" @onclick="() => CopyAsync(InvitePayload() ?? chain.Uri)">Copy invite</button>
                            <button class="chip" @onclick="ToggleQrAsync">
                                @(_showQr ? "Hide QR" : "Show QR")
                            </button>
                        </div>

                        @if (_revealChain)
                        {
                            <div class="chain-words">@chain.Words</div>
                        }

                        @if (_showQr)
                        {
                            <div class="qr-wrap">
                                <img class="qr" alt="Sync invite QR code" src="@QrDataUri(InvitePayload() ?? chain.Uri)" />
                                <div class="card-sub">
                                    @if (App.Sync.Preferences.HasMailbox)
                                    {
                                        <text>Scan on another device after install — joins the chain and applies the mailbox (link + password).</text>
                                    }
                                    else
                                    {
                                        <text>Scan this on the other device, or type the 24 words. Save a mailbox first to include Proton settings in the QR.</text>
                                    }
                                </div>
                            </div>
                        }

                        <div class="card-sub">Chain @_shortId · rotating re-encrypts files on this device and re-uploads them. Other devices must scan the new code.</div>
                        <div class="row wrap">
                            <button class="chip danger" @onclick="RotateAsync">Rotate chain</button>
                            <button class="chip" @onclick="LeaveChainAsync">Leave chain</button>
                        </div>
                    }
                    else
                    {
                        <div class="row wrap">
                            <button class="chip primary" @onclick="CreateChainAsync">Create chain</button>
                            <button class="chip" @onclick="() => _joinOpen = !_joinOpen">Join with code</button>
                            <button class="chip" @onclick="ScanQrAsync">Scan QR</button>
                        </div>
                    }

                    @if (_joinOpen || App.Sync.Chain is null)
                    {
                        <textarea class="field chain-input" rows="3"
                                  placeholder="24 words, syncly:sync:…, or a syncly:invite:… QR payload"
                                  @bind="_joinText"></textarea>
                        <div class="row">
                            <button class="chip primary" @onclick="JoinAsync">Join</button>
                        </div>
                    }

                    @if (_chainMessage is { Length: > 0 })
                    {
                        <div class="card-sub @(_chainError ? "error" : null)">@_chainMessage</div>
                    }
                </div>

                <div class="card">
                    <div class="row">
                        <span class="status-dot @StatusClass"></span>
                        <div class="grow">
                            <div class="card-title">@App.Sync.Status.Summary</div>
                            @if (App.Sync.Status.Detail is { Length: > 0 } detail)
                            {
                                <div class="card-sub">@detail</div>
                            }
                            @if (App.Sync.Status.LastSuccessAt is { } at)
                            {
                                <div class="card-sub">Last success @at.ToLocalTime().ToString("g")</div>
                            }
                        </div>
                        <button class="chip primary" @onclick="() => App.Sync.SyncNowAsync()">Sync now</button>
                    </div>
                </div>

                <div class="card">
                    <div class="card-title">Devices</div>
                    <div class="card-sub">Other devices that have written to this mailbox. Revoking hides them here and ignores new packs they write. Notes already on this device stay.</div>
                    @if (_peers.Count == 0)
                    {
                        <div class="card-sub">No other devices yet. Sync after they join the chain.</div>
                    }
                    else
                    {
                        @foreach (var peer in _peers)
                        {
                            <div class="row wrap" style="margin-top:0.5rem;align-items:flex-start;">
                                <div class="grow">
                                    <div class="card-title">@peer.DisplayName</div>
                                    <div class="card-sub">@ShortId(peer.DeviceId)</div>
                                    @if (peer.LastSyncAt is { } seen && seen > DateTimeOffset.MinValue)
                                    {
                                        <div class="card-sub">Last sync @seen.ToLocalTime().ToString("g")</div>
                                    }
                                </div>
                                <button class="chip danger" @onclick="() => RevokePeerAsync(peer.DeviceId, peer.DisplayName)">
                                    Revoke
                                </button>
                            </div>
                        }
                    }
                    @if (_peerMessage is { Length: > 0 })
                    {
                        <div class="card-sub">@_peerMessage</div>
                    }
                </div>
            </section>

            <section>
                <h2>App</h2>
                <div class="card">
                    <div class="card-title">Version @Updater.CurrentVersion</div>
                    @if (Updater.Available is { } update)
                    {
                        <div class="card-sub">@update.Version is ready. The download is silent.</div>
                        <div class="row wrap">
                            <button class="chip primary" disabled="@Updater.Busy" @onclick="UpdateAsync">
                                @(Updater.Busy ? (Updater.Progress ?? "Updating…") : $"Update to {update.Version}")
                            </button>
                        </div>
                    }
                    else if (Updater.CanSelfUpdate)
                    {
                        <div class="card-sub">@(Updater.Progress ?? "This build is current.")</div>
                        <button class="chip" @onclick="() => Updater.CheckAsync()">Check for updates</button>
                    }
                    else
                    {
                        <div class="card-sub">
                            This copy was not installed from a Syncly installer, so it cannot self-update.
                            Installers are published from the main branch on GitHub.
                        </div>
                    }
                </div>
            </section>

            <section>
                <h2>Identity</h2>
                <div class="card">
                    <div class="card-sub">Name shown on other devices in the mailbox.</div>
                    <div class="row">
                        <input class="field grow" @bind="_deviceName" @bind:event="oninput" />
                        <button class="chip" @onclick="RenameDeviceAsync">Save name</button>
                    </div>
                    <div class="card-sub">Device ID @App.Identity.DeviceId</div>
                    @if (_identityMessage is { Length: > 0 })
                    {
                        <div class="card-sub @(_identityError ? "error" : null)">@_identityMessage</div>
                    }
                </div>
            </section>

            <section>
                <h2>Storage</h2>
                <div class="card">
                    <div class="card-sub">@App.DataDirectory</div>
                    <div class="card-sub">@_pageCount page(s) · @_opCount operation(s) in the log</div>
                    <div class="row">
                        <button class="chip" @onclick="CompactAsync">Compact history</button>
                        <span class="card-sub">@_maintenance</span>
                    </div>
                </div>
            </section>

            <section>
                <h2>Editing</h2>
                <div class="card">
                    <div class="row">
                        <span class="card-title grow">Open pages read-only</span>
                        <button class="chip @(State.ReadingMode ? "primary" : null)"
                                @onclick="State.ToggleReadingMode">
                            @(State.ReadingMode ? "On" : "Off")
                        </button>
                    </div>
                    <div class="card-sub">Ctrl+E toggles it anywhere. Ctrl+K opens the command palette.</div>
                </div>
            </section>

            <section>
                <h2>Shortcuts</h2>
                <div class="card">
                    <div class="shortcuts">
                        <div><kbd>Ctrl</kbd>+<kbd>K</kbd><span>Command palette</span></div>
                        <div><kbd>Ctrl</kbd>+<kbd>E</kbd><span>Reading mode</span></div>
                        <div><kbd>Ctrl</kbd>+<kbd>N</kbd><span>New page</span></div>
                        <div><kbd>Ctrl</kbd>+<kbd>S</kbd><span>Sync now</span></div>
                        <div><kbd>/</kbd><span>Block menu</span></div>
                        <div><kbd>Tab</kbd><span>Indent block</span></div>
                        <div><kbd>Alt</kbd>+<kbd>↑</kbd><span>Move block</span></div>
                        <div><kbd>Ctrl</kbd>+<kbd>B</kbd><span>Bold</span></div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@code {
    private sealed record PeerRow(string DeviceId, string DisplayName, DateTimeOffset? LastSyncAt);

    private int _pageCount;
    private long _opCount;
    private string _maintenance = string.Empty;
    private SyncPreferences _prefs = new();
    private string _joinText = string.Empty;
    private bool _revealChain;
    private bool _showQr;
    private bool _joinOpen;
    private string? _mailboxMessage;
    private bool _mailboxError;
    private string? _chainMessage;
    private bool _chainError;
    private string _deviceName = string.Empty;
    private string? _identityMessage;
    private bool _identityError;
    private List<PeerRow> _peers = [];
    private string? _peerMessage;

    private string? _shortId => App.Sync.Chain is { } chain ? chain.ChainId : null;

    private string StatusClass => App.Sync.Status.Phase switch
    {
        SyncPhase.Idle when App.Sync.IsConfigured => "live",
        SyncPhase.Syncing => "working",
        SyncPhase.Failed => "failed",
        _ => "",
    };

    protected override async Task OnInitializedAsync()
    {
        App.Sync.Changed += Refresh;
        Updater.Changed += Refresh;
        _prefs = App.Sync.Preferences;
        _deviceName = App.Identity.DisplayName;
        _pageCount = App.Workspace.Pages.Count;
        _opCount = await App.OpLog.CountAsync();
        await LoadPeersAsync();
    }

    private void Refresh() => _ = InvokeAsync(async () =>
    {
        _prefs = App.Sync.Preferences;
        _deviceName = App.Identity.DisplayName;
        await LoadPeersAsync();
        StateHasChanged();
    });

    private async Task LoadPeersAsync()
    {
        var self = App.Identity.DeviceId;
        var list = await App.Peers.ListAsync();
        var rows = new List<PeerRow>();
        foreach (var peer in list.Where(p => p.DeviceId != self))
        {
            var state = await App.Peers.StateAsync(peer.DeviceId);
            rows.Add(new PeerRow(
                peer.DeviceId,
                peer.DisplayName,
                state.LastSyncAt > DateTimeOffset.MinValue ? state.LastSyncAt : null));
        }

        _peers = rows;
    }

    private static string ShortId(string deviceId) =>
        deviceId.Length <= 8 ? deviceId : deviceId[..8];

    private string? InvitePayload() => App.Sync.InviteUri();

    private async Task ToggleQrAsync()
    {
        if (!_showQr)
            await SaveMailboxAsync();
        _showQr = !_showQr;
    }

    private async Task SetBackendAsync(SyncBackendKind kind)
    {
        _prefs.Backend = kind;
        await SaveMailboxAsync();
    }

    private async Task SaveMailboxAsync()
    {
        _mailboxError = false;
        try
        {
            await App.Sync.SavePreferencesAsync(_prefs);
            _prefs = App.Sync.Preferences;
            _mailboxMessage = "Saved.";
        }
        catch (Exception ex)
        {
            _mailboxError = true;
            _mailboxMessage = ex.Message;
        }
    }

    private async Task TestMailboxAsync()
    {
        _mailboxError = false;
        _mailboxMessage = "Checking…";
        try
        {
            await App.Sync.SavePreferencesAsync(_prefs);
            await App.Sync.TestBackendAsync();
            _mailboxMessage = "Proton Drive accepted the link. Editor access looks good.";
        }
        catch (Exception ex)
        {
            _mailboxError = true;
            _mailboxMessage = ex.Message;
        }
    }

    private async Task CreateChainAsync()
    {
        _chainError = false;
        try
        {
            await App.Sync.CreateChainAsync();
            _revealChain = true;
            _showQr = true;
            _chainMessage = App.Sync.Preferences.HasMailbox
                ? "Share the QR with your phone — it includes the chain and Proton mailbox."
                : "Share the words or QR with your other devices.";
        }
        catch (Exception ex)
        {
            _chainError = true;
            _chainMessage = ex.Message;
        }
    }

    private async Task JoinAsync()
    {
        _chainError = false;
        try
        {
            await App.Sync.JoinChainAsync(_joinText);
            _prefs = App.Sync.Preferences;
            _joinText = string.Empty;
            _joinOpen = false;
            _chainMessage = App.Sync.LastJoinNote ?? "Joined. Sync now to pull from the mailbox.";
            _ = App.Sync.SyncNowAsync();
            await LoadPeersAsync();
        }
        catch (Exception ex)
        {
            _chainError = true;
            _chainMessage = ex.Message;
        }
    }

    private async Task RotateAsync()
    {
        if (!await Js.InvokeAsync<bool>("syncly.confirm",
                "Rotate the chain? Other devices must scan the new code. This device re-encrypts attachments and uploads them on the next sync."))
            return;

        _chainError = false;
        await App.Sync.RotateChainAsync();
        _revealChain = true;
        _showQr = true;
        _chainMessage = "New chain created. Update every other device.";
    }

    private async Task LeaveChainAsync()
    {
        if (!await Js.InvokeAsync<bool>("syncly.confirm",
                "Leave this chain? This device stops syncing until you create or join another. Your local notes stay. Mailbox settings are kept so you can join a new chain on the same share."))
            return;

        _chainError = false;
        try
        {
            await App.Sync.ClearChainAsync();
            _revealChain = false;
            _showQr = false;
            _joinOpen = true;
            _joinText = string.Empty;
            _chainMessage = "Left the chain. Create a new one or scan an invite to join another.";
            await LoadPeersAsync();
        }
        catch (Exception ex)
        {
            _chainError = true;
            _chainMessage = ex.Message;
        }
    }

    private async Task ScanQrAsync()
    {
        _chainError = false;
        try
        {
            if (!await Camera.EnsurePermissionAsync())
            {
                _joinOpen = true;
                _chainError = true;
                _chainMessage = "Camera permission is required to scan. Paste the invite or 24 words instead.";
                return;
            }

            var value = await QrScanner.ScanAsync();
            if (string.IsNullOrWhiteSpace(value))
            {
                _joinOpen = true;
                _chainMessage = "Scan cancelled. Paste the invite or 24 words instead.";
                return;
            }

            _joinText = value;
            await JoinAsync();
        }
        catch (Exception ex)
        {
            _joinOpen = true;
            _chainError = true;
            _chainMessage = ex.Message + " Paste the invite or 24 words instead.";
        }
    }

    private async Task RenameDeviceAsync()
    {
        _identityError = false;
        try
        {
            await App.RenameDeviceAsync(_deviceName);
            _deviceName = App.Identity.DisplayName;
            _identityMessage = "Name saved. Other devices will see it after the next sync.";
        }
        catch (Exception ex)
        {
            _identityError = true;
            _identityMessage = ex.Message;
        }
    }

    private async Task RevokePeerAsync(string deviceId, string displayName)
    {
        if (!await Js.InvokeAsync<bool>("syncly.confirm",
                $"Revoke {displayName}? They disappear from this list. New edits they sync will not merge here. Notes already on this device stay."))
            return;

        await App.IgnorePeerAsync(deviceId);
        _peerMessage = $"{displayName} revoked.";
        await LoadPeersAsync();
    }

    private async Task CopyAsync(string value)
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", value);
            _chainMessage = "Copied.";
            _chainError = false;
        }
        catch
        {
            _chainMessage = value;
            _chainError = false;
        }
    }

    private static string QrDataUri(string payload)
    {
        using var generator = new QRCoder.QRCodeGenerator();
        var ecc = payload.StartsWith("syncly:invite:", StringComparison.OrdinalIgnoreCase)
            ? QRCoder.QRCodeGenerator.ECCLevel.L
            : QRCoder.QRCodeGenerator.ECCLevel.M;
        using var data = generator.CreateQrCode(payload, ecc);
        var png = new QRCoder.PngByteQRCode(data);
        return "data:image/png;base64," + Convert.ToBase64String(png.GetGraphic(6));
    }

    private async Task CompactAsync()
    {
        _maintenance = "Working…";
        await App.Sync.CollectAsync();
        _opCount = await App.OpLog.CountAsync();
        _maintenance = "Done";
    }

    private Task UpdateAsync() => Updater.ApplyAsync();

    public void Dispose()
    {
        App.Sync.Changed -= Refresh;
        Updater.Changed -= Refresh;
    }
}
